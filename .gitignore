## .NET / C# gitignore

# Build outputs
bin/
obj/
publish/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# Visual Studio
.vs/
*.vsp
*.psess

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Rider
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

.agents/

# Google OAuth client (Download JSON from the Google Cloud console) - never commit
google_oauth.json
client_secret*.json
