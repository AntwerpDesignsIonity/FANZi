<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fanzi.FanControl.ViewModels"
        xmlns:model="using:Fanzi.FanControl.Models"
        xmlns:views="using:Fanzi.FanControl.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="960"
        x:Class="Fanzi.FanControl.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/ionity-logo.ico"
        Title="FANZI — AI-Powered Fan Control &amp; RGB | Ionity Global"
        MinWidth="1100"
        MinHeight="780"
        Background="#050A12"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        ExtendClientAreaChromeHints="NoChrome">

    <Window.Styles>
        <!-- ═══ CARD STYLES ═══ -->
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="#0C1524"/>
            <Setter Property="BorderBrush" Value="#1A2845"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.card-glow">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="#0A1220"/>
            <Setter Property="BorderBrush" Value="#1E3A6E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 0 20 2 #102040"/>
        </Style>
        <Style Selector="Border.card-accent">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="#081018"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 0 24 2 #0A2050"/>
        </Style>

        <!-- ═══ TEXT STYLES ═══ -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5A7FA8"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
        <Style Selector="TextBlock.metric-value">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="#E8F0FF"/>
        </Style>
        <Style Selector="TextBlock.metric-caption">
            <Setter Property="Foreground" Value="#4A6A8F"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="TextBlock.ai-glow">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#34D399"/>
        </Style>

        <!-- ═══ BUTTON STYLES ═══ -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#141E30"/>
            <Setter Property="Foreground" Value="#A0C0E0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E3050"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3B82F6"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
        </Style>
        <Style Selector="Button.success">
            <Setter Property="Background" Value="#064E3B"/>
            <Setter Property="Foreground" Value="#6EE7B7"/>
        </Style>

        <!-- ═══ SLIDER ═══ -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#2563EB"/>
        </Style>

        <!-- ═══ PROFILE TABS ═══ -->
        <Style Selector="Border.profile-tab">
            <Setter Property="Background" Value="#141E30"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>
        <Style Selector="Border.profile-tab.active">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="BoxShadow" Value="0 0 12 1 #1D4ED8"/>
        </Style>

        <!-- ═══ TAB CONTROL ═══ -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Background" Value="#080E18"/>
            <Setter Property="Foreground" Value="#4A6A8F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#0C1524"/>
            <Setter Property="Foreground" Value="#E8F0FF"/>
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="#A0C0E0"/>
        </Style>

        <!-- ═══ TOGGLE SWITCH ═══ -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <!-- ═══════════════ CUSTOM TITLEBAR ═══════════════ -->
        <Border x:Name="TitleBar" Height="38" VerticalAlignment="Top" ZIndex="200" Background="#050A12" IsHitTestVisible="True">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
                    <Image Source="/Assets/ionity-logo.png" Width="20" Height="20" Opacity="0.8"/>
                    <TextBlock Text="FANZI" FontSize="12" FontWeight="Black" Foreground="#2563EB" VerticalAlignment="Center"/>
                    <TextBlock Text="v2.0" FontSize="10" Foreground="#3A5070" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="AI-Powered Fan Control" FontSize="11" Foreground="#3A5070" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" Margin="0,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdated}" FontSize="10" Foreground="#2A4060" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <!-- Window Controls -->
                    <Button x:Name="MinimizeButton" Content="─" Background="Transparent" Foreground="#5A7FA8" FontSize="14" FontWeight="Bold" Padding="12,6" CornerRadius="6" ToolTip.Tip="Minimize"/>
                    <Button x:Name="MaximizeButton" Content="□" Background="Transparent" Foreground="#5A7FA8" FontSize="13" FontWeight="Bold" Padding="12,6" CornerRadius="6" ToolTip.Tip="Maximize"/>
                    <Button x:Name="CloseButton" Content="✕" Background="Transparent" Foreground="#EF4444" FontSize="13" FontWeight="Bold" Padding="12,6" CornerRadius="6" ToolTip.Tip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ LOADER OVERLAY ═══════════════ -->
        <Border IsVisible="{Binding IsLoading}" Background="#050A12" ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
                <Image Source="/Assets/ionity-logo.png" Width="200" Opacity="0.9"/>
                <TextBlock Text="FANZI" FontSize="56" FontWeight="Black" Foreground="#2563EB" HorizontalAlignment="Center"/>
                <TextBlock Text="AI-Powered Fan Control &amp; RGB" FontSize="16" Foreground="#4A6A8F" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="240" Height="3" Foreground="#2563EB" Margin="0,8,0,0"/>
                <TextBlock Text="Initializing thermal intelligence..." FontSize="12" Foreground="#2A4060" HorizontalAlignment="Center"/>
                <TextBlock Text="Ionity Global (Pty) Ltd" FontSize="11" Foreground="#1A3050" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
        <Panel IsVisible="{Binding !IsLoading}" Margin="0,38,0,0">
            <Grid RowDefinitions="Auto,Auto,*" Margin="20,12,20,20" RowSpacing="12">

                <!-- ── PROFILES BAR ──────────────────────────────── -->
                <Border Grid.Row="0" CornerRadius="12" Background="#080E18" BorderBrush="#1A2845" BorderThickness="1" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border CornerRadius="6" Background="#0F1A2A" Padding="8,4">
                                <TextBlock Text="PROFILES" FontSize="10" FontWeight="Black" Foreground="#5A7FA8" LetterSpacing="1"/>
                            </Border>
                        </StackPanel>
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProfileTabViewModel">
                                        <Border CornerRadius="20" Classes="profile-tab" Classes.active="{Binding IsActive}" Margin="0,1">
                                            <StackPanel Orientation="Horizontal" Spacing="0">
                                                <Button Command="{Binding SelectCommand}" Background="Transparent" Foreground="#E8F0FF" Padding="12,5,4,5" CornerRadius="20,0,0,20" IsVisible="{Binding !IsRenaming}">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                                </Button>
                                                <TextBox Text="{Binding Name, Mode=TwoWay}" IsVisible="{Binding IsRenaming}" FontSize="12" Background="Transparent" Foreground="#E8F0FF" BorderThickness="0" Width="100" Padding="12,3,4,3" VerticalAlignment="Center">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Return" Command="{Binding CommitRenameCommand}"/>
                                                        <KeyBinding Gesture="Escape" Command="{Binding CommitRenameCommand}"/>
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <Button Content="✎" Command="{Binding BeginRenameCommand}" IsVisible="{Binding !IsRenaming}" Background="Transparent" Foreground="#5A7FA8" Padding="2,5" CornerRadius="0" FontSize="10"/>
                                                <Button Content="✓" Command="{Binding CommitRenameCommand}" IsVisible="{Binding IsRenaming}" Background="Transparent" Foreground="#34D399" Padding="2,5" CornerRadius="0" FontSize="10"/>
                                                <Button Content="×" Command="{Binding DeleteCommand}" Background="Transparent" Foreground="#6A8AAF" Padding="2,5,8,5" CornerRadius="0,20,20,0" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Column="2" Content="+ New" Command="{Binding AddProfileCommand}" MinWidth="80" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- ── AI STATUS BAR ──────────────────────────────── -->
                <Border Grid.Row="1" CornerRadius="12" Background="#060D18" BorderBrush="#0F2040" BorderThickness="1" Padding="14,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border CornerRadius="10" Background="#0A1A10" BorderBrush="#166534" BorderThickness="1" Padding="8,3">
                                <TextBlock Text="{Binding AiStatus}" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#4A6A8F" FontSize="11" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock Text="Trend:" FontSize="10" Foreground="#3A5A80" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AiTrend}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock Text="Predict:" FontSize="10" Foreground="#3A5A80" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AiPrediction}" FontSize="10" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock Text="AI Fan:" FontSize="10" Foreground="#3A5A80" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AiSuggestedFan}" FontSize="10" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="5" Content="Refresh" Classes="primary" Command="{Binding RefreshCommand}" Padding="10,5" FontSize="10" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <!-- ── TAB CONTROL ───────────────────────────────── -->
                <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}">

                    <!-- ══ TAB: DASHBOARD ═══════════════════════════ -->
                    <TabItem Header="Dashboard">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14" Margin="0,12,0,12">

                                <!-- Anomaly Alert -->
                                <Border IsVisible="{Binding HasAnomaly}" CornerRadius="12" Background="#1C0808" BorderBrush="#991B1B" BorderThickness="1" Padding="16,10">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border CornerRadius="8" Background="#450A0A" Padding="8,4">
                                            <TextBlock Text="{Binding AnomalySeverity}" FontSize="11" FontWeight="Black" Foreground="#FCA5A5"/>
                                        </Border>
                                        <TextBlock Text="{Binding AnomalyMessage}" FontSize="12" Foreground="#FECACA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- CPU Temperatures -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Classes="card-accent">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="CPU PACKAGE" Classes="section-title"/>
                                            <TextBlock Text="{Binding CpuPackageTemperature}" Classes="metric-value"/>
                                            <TextBlock Text="{Binding CpuName}" Classes="metric-caption" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="card-glow">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="AVERAGE CORE" Classes="section-title"/>
                                            <TextBlock Text="{Binding CpuAverageTemperature}" Classes="metric-value"/>
                                            <TextBlock Text="Average across cores" Classes="metric-caption"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="HOTSPOT" Classes="section-title"/>
                                            <TextBlock Text="{Binding CpuHotspotTemperature}" Classes="metric-value"/>
                                            <TextBlock Text="Hottest sensor" Classes="metric-caption"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- CPU Stats + Fan -->
                                <Grid ColumnDefinitions="1.4*,*,*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Classes="card-glow">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding CpuFanName}" Classes="section-title"/>
                                            <TextBlock Text="{Binding CpuFanSpeed}" FontSize="26" FontWeight="Black" Foreground="#E8F0FF"/>
                                            <TextBlock Text="{Binding CpuFanControl}" FontSize="16" FontWeight="Bold" Foreground="#2563EB"/>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding CpuFanDesiredPercent, Mode=TwoWay}" IsEnabled="{Binding CpuFanCanControl}" Margin="0,4"/>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <TextBlock Grid.Column="0" Text="{Binding CpuFanDesiredLabel}" Foreground="#4A6A8F" FontSize="11" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Apply" Classes="primary" Command="{Binding ApplyCpuFanCommand}" IsEnabled="{Binding CpuFanCanControl}" MinWidth="60" Padding="10,5" FontSize="11"/>
                                                <Button Grid.Column="2" Content="Auto" Command="{Binding AutoCpuFanCommand}" IsEnabled="{Binding CpuFanCanControl}" MinWidth="60" Padding="10,5" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="CPU LOAD" Classes="section-title"/>
                                            <TextBlock Text="{Binding CpuTotalLoad}" Classes="metric-value"/>
                                            <TextBlock Text="Utilization" Classes="metric-caption"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="AVG CLOCK" Classes="section-title"/>
                                            <TextBlock Text="{Binding CpuAverageClock}" Classes="metric-value"/>
                                            <TextBlock Text="Core frequency" Classes="metric-caption"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Classes="card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="PKG POWER" Classes="section-title"/>
                                            <TextBlock Text="{Binding CpuPackagePower}" Classes="metric-value"/>
                                            <TextBlock Text="Package draw" Classes="metric-caption"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Classes="card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="VOLTAGE" Classes="section-title"/>
                                            <TextBlock Text="{Binding CpuCoreVoltage}" Classes="metric-value"/>
                                            <TextBlock Text="Vcore" Classes="metric-caption"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- GPU Row -->
                                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Classes="card-glow">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="GPU TEMP" Classes="section-title"/>
                                            <TextBlock Text="{Binding GpuCoreTemperature}" Classes="metric-value"/>
                                            <TextBlock Text="{Binding GpuName}" Classes="metric-caption" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="GPU HOTSPOT" Classes="section-title"/>
                                            <TextBlock Text="{Binding GpuHotspotTemperature}" Classes="metric-value"/>
                                            <TextBlock Text="Junction" Classes="metric-caption"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="GPU LOAD" Classes="section-title"/>
                                            <TextBlock Text="{Binding GpuLoad}" Classes="metric-value"/>
                                            <TextBlock Text="Utilization" Classes="metric-caption"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Classes="card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="GPU CLOCK" Classes="section-title"/>
                                            <TextBlock Text="{Binding GpuClock}" Classes="metric-value"/>
                                            <TextBlock Text="Core clock" Classes="metric-caption"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Classes="card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="GPU POWER" Classes="section-title"/>
                                            <TextBlock Text="{Binding GpuPower}" Classes="metric-value"/>
                                            <TextBlock Text="{Binding GpuVram}" Classes="metric-caption" IsVisible="{Binding GpuVram, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Temp Warning -->
                                <Border IsVisible="{Binding HasCpuTempWarning}" CornerRadius="12" Background="#1C1000" BorderBrush="#92400E" BorderThickness="1" Padding="14,10">
                                    <TextBlock Text="{Binding CpuTempWarningMessage}" Foreground="#FDE68A" FontSize="12" FontWeight="SemiBold"/>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ TAB: FAN CONTROL ═══════════════════════ -->
                    <TabItem Header="Fans">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Margin="0,12,0,12">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fan &amp; Pump Channels" FontSize="20" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <TextBlock Text="{Binding FanCountLabel}" Foreground="#4A6A8F" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="AI Auto-Fan:" FontSize="11" Foreground="#5A7FA8" VerticalAlignment="Center"/>
                                        <ToggleSwitch IsChecked="{Binding AiAutoFanEnabled}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding FanChannels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FanChannelViewModel">
                                            <Border Margin="0,0,0,8" CornerRadius="14" Background="#080E18" BorderBrush="#142238" BorderThickness="1" Padding="16,12">
                                                <Grid ColumnDefinitions="2*,1.1*,1.8*" ColumnSpacing="14">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border CornerRadius="6" Background="#0F1E30" Padding="6,2">
                                                                <TextBlock Text="{Binding DeviceKindBadge}" FontSize="10" FontWeight="Black" Foreground="#3B82F6"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#E8F0FF" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SourceLabel}" Foreground="#2A4060" FontSize="10" IsVisible="{Binding SourceLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="{Binding SpeedLabel}" FontSize="22" FontWeight="Black" Foreground="#2563EB"/>
                                                        <TextBlock Text="{Binding CapabilityMessage}" Foreground="#3A5A80" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="CURRENT" Classes="section-title"/>
                                                        <TextBlock Text="{Binding CurrentControlLabel}" FontSize="18" FontWeight="Bold" Foreground="#E8F0FF"/>
                                                        <TextBlock Text="TARGET" Classes="section-title" Margin="0,6,0,0"/>
                                                        <TextBlock Text="{Binding DesiredControlLabel}" FontSize="14" Foreground="#60A5FA"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding DesiredPercent, Mode=TwoWay}" IsEnabled="{Binding CanControl}"/>
                                                        <Border IsVisible="{Binding ShowMinSpeedWarning}" CornerRadius="8" Background="#1A1000" BorderBrush="#78350F" BorderThickness="1" Padding="8,4">
                                                            <TextBlock Text="Below 20% — bearing wear risk" Foreground="#FDE68A" FontSize="10"/>
                                                        </Border>
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                            <TextBlock Grid.Column="0" Text="0%    50%    100%" Foreground="#2A4060" FontSize="10" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="Apply" Classes="primary" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanControl}" MinWidth="65" Padding="8,5" FontSize="11"/>
                                                            <Button Grid.Column="2" Content="Auto" Command="{Binding AutoCommand}" IsEnabled="{Binding CanControl}" MinWidth="65" Padding="8,5" FontSize="11"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ TAB: SENSORS ═══════════════════════════ -->
                    <TabItem Header="Sensors">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,12">
                                <Border Grid.Column="0" Classes="card" Padding="16">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                        <StackPanel>
                                            <TextBlock Text="CPU Sensors" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                            <TextBlock Text="Temp · Load · Clock · Power" Foreground="#3A5A80" FontSize="10"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="550">
                                            <ItemsControl ItemsSource="{Binding CpuReadings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="model:CpuReadingSnapshot">
                                                        <Border Margin="0,0,0,4" CornerRadius="8" Background="#060C14" Padding="10,5">
                                                            <Grid ColumnDefinitions="2*,*">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#6A8AAF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Classes="card" Padding="16">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                        <StackPanel>
                                            <TextBlock Text="GPU Sensors" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                            <TextBlock Text="Temp · Load · Clock · Power" Foreground="#3A5A80" FontSize="10"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="550">
                                            <ItemsControl ItemsSource="{Binding GpuReadings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="model:GpuReadingSnapshot">
                                                        <Border Margin="0,0,0,4" CornerRadius="8" Background="#060C14" Padding="10,5">
                                                            <Grid ColumnDefinitions="2*,*">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#6A8AAF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ TAB: RGB ════════════════════════════════ -->
                    <TabItem Header="RGB">
                        <views:RgbControlView DataContext="{Binding RgbControl}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- ══ TAB: TASK MANAGER ══════════════════════ -->
                    <TabItem Header="Tasks" IsVisible="{Binding ShowTaskManagerTab}">
                        <views:TaskManagerView DataContext="{Binding TaskManagerVm}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- ══ TAB: NETWORK MANAGER ═══════════════════ -->
                    <TabItem Header="Network" IsVisible="{Binding ShowNetworkManagerTab}">
                        <views:NetworkManagerView DataContext="{Binding NetworkManagerVm}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- ══ TAB: POWER MONITOR ═════════════════════ -->
                    <TabItem Header="Power" IsVisible="{Binding ShowPowerMonitorTab}">
                        <views:PowerMonitorView DataContext="{Binding PowerMonitorVm}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- ══ TAB: SYSTEM CLEANER ════════════════════ -->
                    <TabItem Header="Cleaner" IsVisible="{Binding ShowSystemCleanerTab}">
                        <views:SystemCleanerView DataContext="{Binding SystemCleanerVm}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- ══ TAB: NOTIFICATIONS ═════════════════════ -->
                    <TabItem Header="Alerts">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14" Margin="0,12,0,12">

                                <Border CornerRadius="14" Background="#0A0D04" BorderBrush="#3A5A20" BorderThickness="1" Padding="18,14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Temperature Alert" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <Border IsVisible="{Binding HasCpuTempWarning}" CornerRadius="10" Background="#1C0D00" BorderBrush="#B45309" BorderThickness="1" Padding="12,8">
                                            <TextBlock Text="{Binding CpuTempWarningMessage}" Foreground="#FDE68A" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border IsVisible="{Binding !HasCpuTempWarning}" CornerRadius="10" Background="#041810" BorderBrush="#134E2A" BorderThickness="1" Padding="12,8">
                                            <TextBlock Text="CPU temperature within normal range" Foreground="#6EE7B7" FontSize="12"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="Warn above" Foreground="#6A8AAF" FontSize="12" VerticalAlignment="Center"/>
                                            <NumericUpDown Value="{Binding CpuWarningThresholdDegrees, Mode=TwoWay}" Minimum="50" Maximum="110" Increment="5" Width="110" Foreground="#E8F0FF" Background="#0A1220" FontSize="12" FormatString="0 °C"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="SMTP Email Alerts" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <TextBlock Text="Email alerts when thresholds are exceeded. 10-minute cooldown between alerts." Foreground="#4A6A8F" FontSize="11"/>
                                        <Grid ColumnDefinitions="120,*,70,120" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="SMTP Host" Foreground="#5A7FA8" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SmtpHost, Mode=TwoWay}" Watermark="smtp.gmail.com" Background="#060C14" Foreground="#A0C0E0" BorderBrush="#142238" CornerRadius="8" Padding="8,5" FontSize="12"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Port" Foreground="#5A7FA8" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding SmtpPort, Mode=TwoWay}" Minimum="1" Maximum="65535" FormatString="0" Background="#060C14" Foreground="#A0C0E0" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Username" Foreground="#5A7FA8" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SmtpUser, Mode=TwoWay}" Watermark="you@gmail.com" Background="#060C14" Foreground="#A0C0E0" BorderBrush="#142238" CornerRadius="8" Padding="8,5" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Pass" Foreground="#5A7FA8" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SmtpPassword, Mode=TwoWay}" PasswordChar="•" Background="#060C14" Foreground="#A0C0E0" BorderBrush="#142238" CornerRadius="8" Padding="8,5" FontSize="12"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Send To" Foreground="#5A7FA8" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding NotificationEmail, Mode=TwoWay}" Watermark="recipient@example.com" Background="#060C14" Foreground="#A0C0E0" BorderBrush="#142238" CornerRadius="8" Padding="8,5" FontSize="12"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button Content="Send Test" Classes="primary" Command="{Binding SendTestEmailCommand}" IsEnabled="{Binding SmtpConfigured}" MinWidth="100"/>
                                            <ProgressBar IsIndeterminate="True" Width="60" Height="3" Foreground="#2563EB" IsVisible="{Binding IsSendingEmail}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EmailStatus}" Foreground="#6A8AAF" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ TAB: SETTINGS ══════════════════════════ -->
                    <TabItem Header="Settings">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14" Margin="0,12,0,12">

                                <!-- Startup & Tray -->
                                <Border Classes="card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Startup &amp; System Tray" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start with Windows" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding StartWithWindows}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Start minimized to tray" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding StartMinimized}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Minimize to system tray" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding MinimizeToTray}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Close to tray (keep running)" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding CloseToTray}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border CornerRadius="8" Background="#060C14" Padding="12,8">
                                            <TextBlock Text="When minimized, FANZI reduces polling to save CPU. Right-click the tray icon to restore or exit." Foreground="#3A5A80" FontSize="11" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Shortcuts & Pinning -->
                                <Border Classes="card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Shortcuts &amp; Pinning" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <TextBlock Text="Pin FANZI where you launch things from. The Taskbar pin may need a right-click confirmation on Windows 11."
                                                   Foreground="#5A7899" FontSize="11" TextWrapping="Wrap"/>
                                        <WrapPanel>
                                            <Button Content="📌 Pin to Taskbar"   Command="{Binding PinToTaskbarCommand}"   Padding="14,8" Margin="0,0,8,8" Background="#1E3A60" Foreground="#FFF" CornerRadius="8" FontWeight="Bold"/>
                                            <Button Content="🏠 Pin to Start"     Command="{Binding PinToStartCommand}"      Padding="14,8" Margin="0,0,8,8" Background="#1E3A60" Foreground="#FFF" CornerRadius="8" FontWeight="Bold"/>
                                            <Button Content="🖥 Desktop Shortcut" Command="{Binding CreateDesktopShortcutCommand}" Padding="14,8" Margin="0,0,8,8" Background="#1E3A60" Foreground="#FFF" CornerRadius="8" FontWeight="Bold"/>
                                            <Button Content="📊 Toggle Mini Overlay" Command="{Binding ToggleMiniOverlayCommand}" Padding="14,8" Margin="0,0,8,8" Background="#1E3A60" Foreground="#FFF" CornerRadius="8" FontWeight="Bold"/>
                                            <Button Content="📋 Export Hardware Report" Command="{Binding ExportHardwareReportCommand}" Padding="14,8" Margin="0,0,8,8" Background="#1E3A60" Foreground="#FFF" CornerRadius="8" FontWeight="Bold"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding PinningStatus}" Foreground="#22C55E" FontSize="11"/>
                                        <TextBlock Text="{Binding HardwareReportStatus}" Foreground="#FB923C" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- Profile Manager (disk) -->
                                <Border Classes="card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Profile Library" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#5A7899" FontSize="11">
                                            <Run Text="Saved at "/>
                                            <Run Text="{Binding ProfilesDirectoryPath, Mode=OneWay}" FontFamily="Consolas,monospace" Foreground="#7090B0"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="💾 Save Current Profile" Command="{Binding SaveCurrentProfileCommand}" Classes="primary" Padding="14,6" FontWeight="Bold"/>
                                            <Button Content="🔄 Refresh List" Command="{Binding RefreshProfileListCommand}" Padding="14,6"/>
                                            <Button Content="📁 Open Folder" Command="{Binding OpenProfilesFolderCommand}" Padding="14,6"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProfileSaveStatus}" Foreground="#22C55E" FontSize="11"/>
                                        <Border Background="#061018" CornerRadius="10" MaxHeight="240">
                                            <DataGrid ItemsSource="{Binding DiskProfiles}" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                                      Background="Transparent" Foreground="#C4D8F4" RowBackground="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="Saved" Binding="{Binding LastModifiedDisplay}" Width="140"/>
                                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80"/>
                                                    <DataGridTemplateColumn Header="Actions" Width="180">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="Load" Padding="10,3" FontSize="11"
                                                                            Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).LoadProfileFromDiskCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Content="Delete" Padding="10,3" FontSize="11" Background="#7C2D12" Foreground="#FFF"
                                                                            Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).DeleteProfileFromDiskCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Modular Section Toggles -->
                                <Border Classes="card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Modular Sections" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <TextBlock Text="Show/hide tabs you don't use. Disabled sections stop their background polling." Foreground="#5A7899" FontSize="11" TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Task Manager tab" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding ShowTaskManagerTab}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Network Manager tab" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding ShowNetworkManagerTab}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Power Monitor &amp; Drives tab" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding ShowPowerMonitorTab}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" Margin="0,6,0,0">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="System Cleaner tab (cache + RAM cleaner)" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding ShowSystemCleanerTab}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- AI Settings -->
                                <Border Classes="card-accent">
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border CornerRadius="8" Background="#0A1A10" Padding="8,4">
                                                <TextBlock Text="AI" FontSize="11" FontWeight="Black" Foreground="#34D399"/>
                                            </Border>
                                            <TextBlock Text="Thermal Intelligence" FontSize="16" FontWeight="Black" Foreground="#E8F0FF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                                <TextBlock Text="AI Auto-Fan Control" Foreground="#A0C0E0" FontSize="13"/>
                                                <TextBlock Text="AI continuously adjusts fan speed using predictive thermal modeling" Foreground="#3A5A80" FontSize="10"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding AiAutoFanEnabled}" HorizontalAlignment="Right"/>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Anomaly Detection" Foreground="#A0C0E0" FontSize="13"/>
                                                <TextBlock Text="Detect thermal spikes, fan stalls, and unusual behavior patterns" Foreground="#3A5A80" FontSize="10"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding AiAnomalyDetection}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border CornerRadius="8" Background="#040A10" Padding="12,8">
                                            <TextBlock TextWrapping="Wrap" Foreground="#4A6A8F" FontSize="11"
                                                       Text="The AI engine uses PD-control thermal prediction with exponential smoothing. It learns from your system's thermal characteristics over time and pre-emptively adjusts fan speed before temperatures spike."/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- About -->
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <Image Source="/Assets/ionity-logo.png" Width="48" Opacity="0.9"/>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="FANZI v2.0" FontSize="18" FontWeight="Black" Foreground="#2563EB"/>
                                                <TextBlock Text="AI-Powered Fan Control &amp; RGB Lighting" FontSize="12" Foreground="#6A8AAF"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="© 2018-2026 Antwerp Designs. ALL Rights Reserved." Foreground="#2A4060" FontSize="11"/>
                                        <TextBlock Text="Johan Wilhelm van Antwerp · AI@IONITY.TODAY" Foreground="#2A4060" FontSize="11"/>
                                        <TextBlock Text="POL986 AED License 990|900 · FREE TO USE" Foreground="#2A4060" FontSize="11"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#2A4060" FontSize="10"
                                                   Text="Powered by LibreHardwareMonitor, OpenRGB, Avalonia UI, and custom AI thermal intelligence."/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>

            </Grid>

            <!-- ── HELP PANEL ──────────────────────────────────── -->
            <Border IsVisible="{Binding ShowHelp}" ZIndex="50" Margin="20,80,20,0" VerticalAlignment="Top"
                    CornerRadius="14" Background="#0A1220" BorderBrush="#1A2845" BorderThickness="1" Padding="20" BoxShadow="0 8 32 4 #000000">
                <StackPanel Spacing="10">
                    <TextBlock Text="FANZI Quick Guide" FontSize="18" FontWeight="Black" Foreground="#E8F0FF"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#6A8AAF" FontSize="12" Text="FANZI requires administrator privileges to access hardware sensors via LibreHardwareMonitor kernel drivers."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#6A8AAF" FontSize="12" Text="Fan channels are auto-detected. Use sliders to set manual duty, Apply to commit, Auto to restore BIOS control."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#6A8AAF" FontSize="12" Text="RGB control requires OpenRGB running with SDK server enabled (port 6742). Connect via the RGB tab."/>
                    <TextBlock TextWrapping="Wrap" Foreground="#6A8AAF" FontSize="12" Text="AI engine learns your system's thermal characteristics and predictively adjusts fans. Enable in Settings."/>
                    <Button Content="Close" Command="{Binding ToggleHelpCommand}" HorizontalAlignment="Right" MinWidth="80"/>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>

</Window>
