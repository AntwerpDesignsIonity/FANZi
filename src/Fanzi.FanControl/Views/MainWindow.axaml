<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fanzi.FanControl.ViewModels"
        xmlns:model="using:Fanzi.FanControl.Models"
        xmlns:views="using:Fanzi.FanControl.Views"
        xmlns:conv="using:Fanzi.FanControl.Converters"
        xmlns:controls="using:Fanzi.FanControl.Controls"
        xmlns:services="using:Fanzi.FanControl.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="960"
        x:Class="Fanzi.FanControl.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/ionity-logo-rounded.ico"
        Title="FANZi IO-nity — AI Thermal Intelligence &amp; RGB | Ionity Global"
        MinWidth="1100"
        MinHeight="780"
        Background="#050A12"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        ExtendClientAreaChromeHints="NoChrome"
        Classes.reduce-motion="{Binding ReduceMotion}">

    <!-- Card / button / tab styles live in Styles/FanziTheme.axaml (included by App.axaml). -->

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <!-- ═══════════════ CUSTOM TITLEBAR ═══════════════ -->
        <Border x:Name="TitleBar" Height="38" VerticalAlignment="Top" ZIndex="200" Background="#050A12" IsHitTestVisible="True">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
                    <!-- Logo with a soft blurred radial glow behind it -->
                    <Panel Width="22" Height="22" VerticalAlignment="Center">
                        <Ellipse Width="30" Height="30" Margin="-4" Fill="{StaticResource LogoGlow}" Opacity="0.8"
                                 IsHitTestVisible="False" Effect="blur(6)"/>
                        <Image Source="/Assets/ionity-logo.png" Width="20" Height="20" Opacity="0.95"/>
                    </Panel>
                    <TextBlock Text="FANZi IO-nity" FontSize="12" FontWeight="Black" Foreground="{StaticResource AccentGradient}" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static services:AppVersion.ShortLabel}" FontSize="10" Foreground="#3A5070" VerticalAlignment="Center"/>
                    <!-- Shown only when a newer release is published; opens the release page -->
                    <Button IsVisible="{Binding IsUpdateAvailable}" Command="{Binding OpenUpdatePageCommand}"
                            ToolTip.Tip="{Binding UpdateTooltip}" Content="{Binding UpdateBadgeText}"
                            Background="#3366FF" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"
                            Padding="8,2" CornerRadius="9" VerticalAlignment="Center" Cursor="Hand"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="AI Thermal Intelligence" FontSize="11" Foreground="#3A5070" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" Margin="0,0,4,0" VerticalAlignment="Center">
                    <!-- 4.1: names the colour of the running thermal frame (blue cold · green stable · red hot) -->
                    <Border x:Name="ThermalFrameChip" IsVisible="{Binding ThermalFrameEnabled}"
                            CornerRadius="9" Padding="8,2" Margin="0,0,12,0" BorderThickness="1" VerticalAlignment="Center"
                            Background="{Binding FrameTemperatureValue, Converter={x:Static conv:ThermalFrameColorConverter.Instance}, ConverterParameter=soft}"
                            BorderBrush="{Binding FrameTemperatureValue, Converter={x:Static conv:ThermalFrameColorConverter.Instance}, ConverterParameter=edge}"
                            ToolTip.Tip="{Binding FrameTemperatureTooltip}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.6"/>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.6"/>
                            </Transitions>
                        </Border.Transitions>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{Binding FrameTemperatureValue, Converter={x:Static conv:ThermalFrameColorConverter.Instance}}"/>
                            <TextBlock x:Name="ThermalFrameChipText" Text="{Binding FrameTemperatureText}" FontSize="10" FontWeight="Bold"
                                       Foreground="{Binding FrameTemperatureValue, Converter={x:Static conv:ThermalFrameColorConverter.Instance}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- v4: one-click mini overlay (also Ctrl+O, tray menu and Settings → Overlay Studio) -->
                    <Button x:Name="OverlayTitleButton" Command="{Binding ToggleMiniOverlayCommand}"
                            Classes="title-overlay" Classes.active="{Binding MiniOverlayVisible}"
                            Padding="10,4" CornerRadius="8" Margin="0,0,6,0" VerticalAlignment="Center"
                            ToolTip.Tip="Show / hide the mini overlay (Ctrl+O) — right-click it to customise"
                            AutomationProperties.Name="Toggle the mini overlay">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="▣" FontSize="12" FontWeight="Black" VerticalAlignment="Center"/>
                            <TextBlock Text="Overlay" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Window Controls -->
                    <Button x:Name="HelpButton" Content="?" Command="{Binding ToggleHelpCommand}" Background="Transparent" Foreground="#5A7FA8" FontSize="13" FontWeight="Black" Padding="12,6" CornerRadius="6"
                            ToolTip.Tip="Help &amp; keyboard shortcuts (F1)" AutomationProperties.Name="Help and keyboard shortcuts"/>
                    <Button x:Name="MinimizeButton" Content="─" Background="Transparent" Foreground="#5A7FA8" FontSize="14" FontWeight="Bold" Padding="12,6" CornerRadius="6" ToolTip.Tip="Minimize"
                            AutomationProperties.Name="Minimize window"/>
                    <Button x:Name="MaximizeButton" Content="□" Background="Transparent" Foreground="#5A7FA8" FontSize="13" FontWeight="Bold" Padding="12,6" CornerRadius="6" ToolTip.Tip="Maximize"
                            AutomationProperties.Name="Maximize or restore window"/>
                    <Button x:Name="CloseButton" Content="✕" Background="Transparent" Foreground="#EF4444" FontSize="13" FontWeight="Bold" Padding="12,6" CornerRadius="6" ToolTip.Tip="Close"
                            AutomationProperties.Name="Close window"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ LOADER OVERLAY ═══════════════ -->
        <Border IsVisible="{Binding IsLoading}" Classes.loading="{Binding IsLoading}"
                Background="{StaticResource LoaderBackground}" ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
                <!-- Pulsing glow behind the logo (animation in FanziTheme: Border.loading Ellipse.logo-pulse) -->
                <Panel Width="200" HorizontalAlignment="Center">
                    <Ellipse Classes="logo-pulse" Width="300" Height="300" Margin="-50" Fill="{StaticResource LogoGlow}"
                             IsHitTestVisible="False" Effect="blur(24)"/>
                    <Image Source="/Assets/ionity-logo.png" Width="200" Opacity="0.95"/>
                </Panel>
                <TextBlock Text="FANZi IO-nity" FontSize="56" FontWeight="Black" Foreground="{StaticResource AccentGradient}" HorizontalAlignment="Center"/>
                <TextBlock Text="AI Thermal Intelligence &amp; RGB Control" FontSize="16" Foreground="#4A6A8F" HorizontalAlignment="Center"/>
                <!-- Spinning conic-gradient ring (animation in FanziTheme: Border.loading Arc.spinner) -->
                <Panel Width="44" Height="44" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Ellipse Stroke="#142238" StrokeThickness="4"/>
                    <Arc Classes="spinner" StartAngle="0" SweepAngle="300" StrokeThickness="4" StrokeLineCap="Round"
                         Stroke="{StaticResource SpinnerGradient}" RenderTransformOrigin="50%,50%">
                        <Arc.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Arc.RenderTransform>
                    </Arc>
                </Panel>
                <TextBlock Text="Initializing thermal intelligence..." FontSize="12" Foreground="{StaticResource FanziTextMutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Ionity Global (Pty) Ltd" FontSize="11" Foreground="#1A3050" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
        <Panel IsVisible="{Binding !IsLoading}" Margin="0,38,0,0">
            <Grid ColumnDefinitions="*,280" Margin="20,12,20,20" ColumnSpacing="12">

                <!-- ═══ LEFT: Main Content ═══ -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="12">

                <!-- ── 4.2 HUD: live metrics strip + profiles / AEDi / RGB status (replaces the v4 profiles + status bars) ── -->
                <Border Grid.Row="0" x:Name="DashboardHud" Classes="hud" Padding="14,12">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                        <!-- Row 1: live readings -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*,*,*,Auto" ColumnSpacing="8">
                            <Border x:Name="HudCpuTemp" Grid.Column="0" Classes="hud-tile" ToolTip.Tip="CPU package temperature">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CPU TEMP" Classes="hud-label"/>
                                    <TextBlock Text="{Binding CpuPackageTemperature}" Classes="hud-value" Foreground="{Binding CpuGaugeTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="HudGpuTemp" Grid.Column="1" Classes="hud-tile" ToolTip.Tip="GPU core temperature">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="GPU TEMP" Classes="hud-label"/>
                                    <TextBlock Text="{Binding GpuCoreTemperature}" Classes="hud-value" Foreground="{Binding GpuCoreTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="HudCpuLoad" Grid.Column="2" Classes="hud-tile" ToolTip.Tip="Total CPU load">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CPU LOAD" Classes="hud-label"/>
                                    <TextBlock Text="{Binding CpuTotalLoad}" Classes="hud-value" Foreground="#E8F0FF"/>
                                    <ProgressBar Classes="hud-bar" Minimum="0" Maximum="100" Value="{Binding CpuLoadValue}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="HudGpuLoad" Grid.Column="3" Classes="hud-tile" ToolTip.Tip="GPU load">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="GPU LOAD" Classes="hud-label"/>
                                    <TextBlock Text="{Binding GpuLoad}" Classes="hud-value" Foreground="#E8F0FF"/>
                                    <ProgressBar Classes="hud-bar" Minimum="0" Maximum="100" Value="{Binding GpuLoadValue}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="HudFan" Grid.Column="4" Classes="hud-tile" ToolTip.Tip="CPU fan speed">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CPU FAN" Classes="hud-label"/>
                                    <TextBlock Text="{Binding CpuFanSpeed}" Classes="hud-value" Foreground="#E8F0FF"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="HudRam" Grid.Column="5" Classes="hud-tile" ToolTip.Tip="Memory in use">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="RAM" Classes="hud-label"/>
                                    <TextBlock Text="{Binding RamUsageText}" Classes="hud-value" Foreground="#E8F0FF"/>
                                    <ProgressBar Classes="hud-bar" Minimum="0" Maximum="100" Value="{Binding RamUsedPercentValue}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="HudHealth" Grid.Column="6" Classes="hud-tile" ToolTip.Tip="IO-nity system health score (100 = cool and calm)">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="HEALTH" Classes="hud-label"/>
                                    <TextBlock Text="{Binding HealthScore}" Classes="hud-value" Foreground="#E8F0FF"/>
                                    <ProgressBar Classes="hud-bar" Minimum="0" Maximum="100" Value="{Binding HealthScoreValue}"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="7" Content="⟳" Classes="primary hud-refresh" Command="{Binding RefreshCommand}"
                                    ToolTip.Tip="Read all sensors now (F5)" AutomationProperties.Name="Refresh sensors"/>
                        </Grid>
                        <!-- Row 2: profiles · AEDi · RGB · status -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="PROFILE" Classes="hud-label" VerticalAlignment="Center"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="440">
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProfileTabViewModel">
                                            <Border CornerRadius="20" Classes="profile-tab" Classes.active="{Binding IsActive}" Margin="0,1">
                                                <StackPanel Orientation="Horizontal" Spacing="0">
                                                    <Button Command="{Binding SelectCommand}" Background="Transparent" Foreground="#E8F0FF" Padding="12,5,4,5" CornerRadius="20,0,0,20" IsVisible="{Binding !IsRenaming}">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                                    </Button>
                                                    <TextBox Text="{Binding Name, Mode=TwoWay}" IsVisible="{Binding IsRenaming}" FontSize="12" Background="Transparent" Foreground="#E8F0FF" BorderThickness="0" Width="100" Padding="12,3,4,3" VerticalAlignment="Center">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Gesture="Return" Command="{Binding CommitRenameCommand}"/>
                                                            <KeyBinding Gesture="Escape" Command="{Binding CommitRenameCommand}"/>
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                    <Button Content="✎" Command="{Binding BeginRenameCommand}" IsVisible="{Binding !IsRenaming}" Background="Transparent" Foreground="#5A7FA8" Padding="2,5" CornerRadius="0" FontSize="10"
                                                            ToolTip.Tip="Rename" AutomationProperties.Name="{Binding Name, StringFormat='Rename profile {0}'}"/>
                                                    <Button Content="✓" Command="{Binding CommitRenameCommand}" IsVisible="{Binding IsRenaming}" Background="Transparent" Foreground="#34D399" Padding="2,5" CornerRadius="0" FontSize="10"
                                                            ToolTip.Tip="Save name" AutomationProperties.Name="{Binding Name, StringFormat='Save the name of profile {0}'}"/>
                                                    <Button Content="×" Command="{Binding DeleteCommand}" Background="Transparent" Foreground="#6A8AAF" Padding="2,5,8,5" CornerRadius="0,20,20,0" FontSize="12"
                                                            ToolTip.Tip="Delete" AutomationProperties.Name="{Binding Name, StringFormat='Delete profile {0}'}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                                <Button Content="+" Command="{Binding AddProfileCommand}" Classes="hud-chip" ToolTip.Tip="New profile"
                                        AutomationProperties.Name="Add profile"/>
                            </StackPanel>
                            <Border Grid.Column="1" Classes="pill" Background="#0A1A10" BorderBrush="#166534" Padding="8,3" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding AiPrediction, StringFormat='AEDi forecast: {0}'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding AiStatus}" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                    <TextBlock Text="{Binding AiTrend}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                                    <TextBlock Text="{Binding AiSuggestedFan, StringFormat='fan {0}'}" FontSize="10" FontWeight="Bold" Foreground="#A7F3D0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- RGB status chip: dot follows the OpenRGB connection (red when another RGB app overrides FANZi); click jumps to the RGB tab -->
                                <Button Classes="ghost" Command="{Binding OpenRgbTabCommand}" Padding="8,3" CornerRadius="14"
                                        ToolTip.Tip="{Binding RgbControl.ConnectionStatus}"
                                        AutomationProperties.Name="{Binding RgbControl.ConnectionChipText, StringFormat='RGB {0}. Open the RGB tab'}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="7" Height="7" Fill="{Binding RgbControl.ConnectionDotColor}" VerticalAlignment="Center"/>
                                        <TextBlock Text="RGB" FontSize="10" FontWeight="Black" Foreground="#A0C0E0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RgbChipText" Text="{Binding RgbControl.ConnectionChipText}" FontSize="10" Foreground="#6A8AAF"
                                                   MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- Status text takes the leftover width; hidden by code-behind when too narrow (never a bare "…") -->
                            <Border x:Name="StatusMessageHost" Grid.Column="3" Background="Transparent"
                                    ToolTip.Tip="{Binding StatusMessage}">
                                <TextBlock x:Name="StatusMessageText" Text="{Binding StatusMessage}" Foreground="{StaticResource FanziTextMutedBrush}" FontSize="11"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <TextBlock Grid.Column="4" Text="{Binding LastUpdated}" FontSize="10" Foreground="{StaticResource FanziTextDimBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── TAB CONTROL ───────────────────────────────── -->
                <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">

                    <!-- ══ TAB: DASHBOARD ═══════════════════════════ -->
                    <TabItem Header="Dashboard">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14" Margin="0,12,12,12">

                                <!-- Anomaly Alert -->
                                <Border IsVisible="{Binding HasAnomaly}" CornerRadius="12" Background="#1C0808" BorderBrush="#991B1B" BorderThickness="1" Padding="16,10"
                                        BoxShadow="0 0 20 2 #300A0A">
                                    <Border.Transitions>
                                        <Transitions>
                                            <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                                        </Transitions>
                                    </Border.Transitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border CornerRadius="8" Background="#450A0A" Padding="8,4"
                                                BoxShadow="0 0 8 1 #600000">
                                            <TextBlock Text="{Binding AnomalySeverity}" FontSize="11" FontWeight="Black" Foreground="#FCA5A5"/>
                                        </Border>
                                        <TextBlock Text="{Binding AnomalyMessage}" FontSize="12" Foreground="#FECACA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- Temp Warning -->
                                <Border IsVisible="{Binding HasCpuTempWarning}" CornerRadius="12" Background="#1C1000" BorderBrush="#92400E" BorderThickness="1" Padding="14,10">
                                    <TextBlock Text="{Binding CpuTempWarningMessage}" Foreground="#FDE68A" FontSize="12" FontWeight="SemiBold"/>
                                </Border>

                                <!-- IO-nity AI HERO: health gauge · CPU/GPU gauges · Game Mode + AI Coach -->
                                <Border CornerRadius="20" BorderThickness="1.5"
                                        BorderBrush="{StaticResource AccentGradientSoft}"
                                        Background="{StaticResource HeroBackground}"
                                        BoxShadow="0 0 48 4 #2E2563EB, inset 0 1 0 0 #1AFFFFFF">
                                    <Panel>
                                        <!-- Radial glow layers over the linear navy base -->
                                        <Border CornerRadius="20" Background="{StaticResource HeroGlow}" IsHitTestVisible="False"/>
                                        <Border CornerRadius="20" Background="{StaticResource HeroGlowSecondary}" IsHitTestVisible="False"/>

                                        <Grid ColumnDefinitions="1.1*,2*,1.3*" ColumnSpacing="20" Margin="24,20">

                                            <!-- LEFT: IO-nity health gauge (inverted scale: high = cool) -->
                                            <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">
                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" ClipToBounds="False">
                                                    <controls:ThermalGauge Value="{Binding HealthScoreValue}"
                                                                           ValueText="{Binding HealthScore}"
                                                                           Minimum="0" Maximum="100" IsInverted="True"
                                                                           Size="172" Thickness="13"
                                                                           Label="IO-NITY HEALTH" Unit="/100"/>
                                                </Viewbox>
                                                <Border Classes="pill" Background="{StaticResource AccentGradient}" BorderThickness="0"
                                                        Padding="16,4" HorizontalAlignment="Center" BoxShadow="0 0 16 1 #4D7C3AED">
                                                    <TextBlock Text="{Binding HealthGrade}" FontSize="16" FontWeight="Black" Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding HealthSummary}" FontSize="11" Foreground="#6A8FC0"
                                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                <!-- Capped at 2 lines so the hero stays calm at the hot state; the full insights are the tooltip -->
                                                <TextBlock x:Name="HealthInsightsText" Text="{Binding HealthInsights}" FontSize="10" Classes="muted"
                                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HealthInsights}"/>
                                            </StackPanel>

                                            <!-- MIDDLE: CPU + GPU temperature gauges -->
                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="12" VerticalAlignment="Center">
                                                <StackPanel Grid.Column="0" Spacing="8">
                                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" ClipToBounds="False">
                                                        <!-- Package → hotspot → average core; shows a dash placeholder when no CPU sensor exists -->
                                                        <controls:ThermalGauge Value="{Binding CpuGaugeTempValue}"
                                                                               Size="160" Thickness="12" Label="CPU" Unit="°C"/>
                                                    </Viewbox>
                                                    <!-- Wraps to 2 lines so long model names ("…8-Core Processor", "RTX 4080 SUPER") stay readable at MinWidth -->
                                                    <TextBlock x:Name="HeroCpuNameText" Text="{Binding CpuName}" Classes="metric-caption" HorizontalAlignment="Center"
                                                               TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding CpuName}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="8">
                                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" ClipToBounds="False">
                                                        <controls:ThermalGauge Value="{Binding GpuCoreTempValue}"
                                                                               Size="160" Thickness="12" Label="GPU" Unit="°C"/>
                                                    </Viewbox>
                                                    <TextBlock x:Name="HeroGpuNameText" Text="{Binding GpuName}" Classes="metric-caption" HorizontalAlignment="Center"
                                                               TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding GpuName}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- RIGHT: compact Game Mode + AI Coach cards -->
                                            <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Center">

                                                <Border Classes="tile" Background="#B30A1422" Padding="14,12">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="GAME MODE AI" Classes="label-caps" TextTrimming="CharacterEllipsis"/>
                                                        <!-- Short static title (never trims); the game name + session length wrap on the line below -->
                                                        <TextBlock x:Name="GameModeTitleText" Text="{Binding GameModeTitle}"
                                                                   FontSize="15" FontWeight="Black" Foreground="#22C55E"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GameModeStatus}"/>
                                                        <TextBlock x:Name="GameModeDetailText" Text="{Binding GameModeDetail}" FontSize="11" Classes="muted"
                                                                   IsVisible="{Binding IsGameMode}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding GameModeStatus}"/>
                                                        <Border IsVisible="{Binding IsGameMode}" Classes="pill" HorizontalAlignment="Left"
                                                                Background="#064E3B" BorderBrush="#166534">
                                                            <TextBlock Text="🎮 Gaming profile active" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                                        </Border>
                                                        <Border IsVisible="{Binding !IsGameMode}" Classes="pill" HorizontalAlignment="Left">
                                                            <!-- The title already says "Desktop mode"; the pill states why -->
                                                            <TextBlock Text="🖥️ No game detected" FontSize="11" FontWeight="Bold" Foreground="#5A7FA8"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="tile" Background="#B30A1422" Padding="14,12">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="AI THERMAL COACH" Classes="label-caps" TextTrimming="CharacterEllipsis"/>
                                                        <Border Classes="pill" HorizontalAlignment="Left" Background="#0A1A10" BorderBrush="#166534" Padding="8,2">
                                                            <TextBlock Text="{Binding AiStatus}" FontSize="10" FontWeight="Black" Foreground="#34D399"/>
                                                        </Border>
                                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="TREND" Classes="label-caps" FontSize="9" LetterSpacing="1" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AiTrend}" FontSize="13" FontWeight="Black" Foreground="#60A5FA"
                                                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="30s FORECAST" Classes="label-caps" FontSize="9" LetterSpacing="1" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="CoachForecastText" Grid.Row="1" Grid.Column="1" Text="{Binding AiForecast}" FontSize="13" FontWeight="Black" Foreground="#FBBF24"
                                                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="Predicted CPU temperature in 30 seconds (-- while AEDi is still learning)"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="AI FAN" Classes="label-caps" FontSize="9" LetterSpacing="1" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AiSuggestedFan}" FontSize="13" FontWeight="Black" Foreground="#34D399"
                                                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Panel>
                                </Border>

                                <!-- Coach Recommendations -->
                                <Border IsVisible="{Binding HasCoachRecommendations}" Classes="tile" BorderBrush="{StaticResource CardBorderGradient}" Padding="16,10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="🧠 AI COACH RECOMMENDATIONS" Classes="label-caps"/>
                                        <TextBlock Text="{Binding CoachRecommendations}" FontSize="11" Foreground="#A0C0E0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4.4 AEDi: Cooling Fingerprint (predictive cooling maintenance) | Self-Doctor (auto-debugging) -->
                                <Grid x:Name="AediCards" ColumnDefinitions="*,*" ColumnSpacing="14">
                                    <Border x:Name="CoolingFingerprintCard" Grid.Column="0" Classes="tile" BorderBrush="{StaticResource CardBorderGradient}" Padding="16,12">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="🧬 AEDi COOLING FINGERPRINT" Classes="label-caps" VerticalAlignment="Center"
                                                           ToolTip.Tip="AEDi learns your cooler's thermal resistance (°C per CPU watt) and forecasts when dust or ageing paste needs attention."/>
                                                <Border Grid.Column="1" Classes="pill" Padding="8,2" BorderBrush="{Binding CoolingStateColor}">
                                                    <TextBlock Text="{Binding CoolingStateLabel}" FontSize="10" FontWeight="Black" Foreground="{Binding CoolingStateColor}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="CoolingHeadlineText" Text="{Binding CoolingHeadline}" FontSize="15" FontWeight="Black" Foreground="#E8F0FF" TextWrapping="Wrap"/>
                                            <ProgressBar Minimum="0" Maximum="110" Value="{Binding CoolingEfficiencyValue}" Height="6" CornerRadius="3" Foreground="{Binding CoolingStateColor}"/>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="EFFICIENCY" Classes="label-caps" FontSize="9"/>
                                                    <TextBlock Text="{Binding CoolingEfficiency}" FontSize="13" FontWeight="Black" Foreground="#60A5FA" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="THERMAL R" Classes="label-caps" FontSize="9"/>
                                                    <TextBlock Text="{Binding CoolingResistance}" FontSize="13" FontWeight="Black" Foreground="#A78BFA" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="1">
                                                    <TextBlock Text="CLEAN IN" Classes="label-caps" FontSize="9"/>
                                                    <TextBlock Text="{Binding CoolingForecast}" FontSize="13" FontWeight="Black" Foreground="#FBBF24" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding CoolingDetail}" FontSize="11" Foreground="#A0C0E0" TextWrapping="Wrap"/>
                                            <Button Content="Re-learn (new cooler / repaste)" Command="{Binding RelearnCoolingCommand}" Padding="10,3" FontSize="10" HorizontalAlignment="Left"
                                                    ToolTip.Tip="Forget the learned fingerprint and learn this cooler again"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SelfDoctorCard" Grid.Column="1" Classes="tile" BorderBrush="{StaticResource CardBorderGradient}" Padding="16,12">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="⚕ AEDi SELF-DOCTOR" Classes="label-caps" VerticalAlignment="Center"
                                                           ToolTip.Tip="Auto-debugging: every 30 s FANZi checks its sensors, fans, RGB link, MAXSUN service, memory, responsiveness and error log, and repairs what it safely can."/>
                                                <Border Grid.Column="1" Classes="pill" Padding="8,2">
                                                    <TextBlock Text="{Binding DoctorFixesLabel}" FontSize="10" FontWeight="Black" Foreground="#60A5FA"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding DoctorSummary}" FontSize="13" FontWeight="Bold" Foreground="#E8F0FF" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding DoctorChecks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="services:DoctorCheck">
                                                        <Grid ColumnDefinitions="18,Auto,*" ColumnSpacing="6" Margin="0,1" ToolTip.Tip="{Binding Detail}">
                                                            <TextBlock Text="{Binding Icon}" FontWeight="Black" Foreground="{Binding Color}" FontSize="12"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="#C8D8F0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Foreground="#7A9AC0" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Run checks now" Command="{Binding RunDoctorCommand}" Padding="10,3" FontSize="10"/>
                                                <Button Content="Save diagnostics" Command="{Binding SaveDiagnosticsCommand}" Padding="10,3" FontSize="10"
                                                        ToolTip.Tip="Zip logs, crash logs, redacted settings and the Self-Doctor report to Documents\FANZi\Diagnostics"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- CPU | GPU: side-by-side panels; header, temperature and stat rows line up across both
                                     (shared size groups), every card in a row has the same height. -->
                                <Grid x:Name="HardwarePanels" ColumnDefinitions="*,*" ColumnSpacing="14" Grid.IsSharedSizeScope="True">
                                    <Border x:Name="CpuPanel" Grid.Column="0" Classes="hw-panel">
                                        <Grid RowSpacing="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" SharedSizeGroup="HwHeader"/>
                                                <RowDefinition Height="Auto" SharedSizeGroup="HwTemps"/>
                                                <RowDefinition Height="Auto" SharedSizeGroup="HwStats"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <Border Classes="hw-badge cpu" VerticalAlignment="Center">
                                                    <TextBlock Text="CPU"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <!-- Wraps to 2 lines so long model names stay readable at MinWidth; full name in the tooltip -->
                                                    <TextBlock x:Name="CpuPackageNameText" Text="{Binding CpuName}" Classes="hw-name"
                                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CpuName}"/>
                                                    <TextBlock Text="Processor · live sensors" Classes="metric-caption" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                                <Border Grid.Column="0" Classes="card temp-card compact"
                                                        BorderBrush="{Binding CpuPackageTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}">
                                                    <Border.BoxShadow>
                                                        <MultiBinding Converter="{x:Static conv:TemperatureToBoxShadowConverter.Instance}">
                                                            <Binding Path="CpuPackageTempValue"/>
                                                            <Binding Path="IsPointerOver" RelativeSource="{RelativeSource Self}"/>
                                                        </MultiBinding>
                                                    </Border.BoxShadow>
                                                    <StackPanel Spacing="4">
                                                        <Border Classes="temp-bar" Background="{Binding CpuPackageTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}"/>
                                                        <TextBlock Text="PACKAGE" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <!-- Scales down instead of clipping in narrow cards (MinWidth 1100) -->
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding CpuPackageTemperature}" Classes="metric-value"
                                                                       Foreground="{Binding CpuPackageTempValue, Converter={x:Static conv:TemperatureToGradientConverter.Instance}}"/>
                                                        </Viewbox>
                                                        <TextBlock Text="CPU package" Classes="metric-caption" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Classes="card temp-card compact"
                                                        BorderBrush="{Binding CpuAverageTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}">
                                                    <Border.BoxShadow>
                                                        <MultiBinding Converter="{x:Static conv:TemperatureToBoxShadowConverter.Instance}">
                                                            <Binding Path="CpuAverageTempValue"/>
                                                            <Binding Path="IsPointerOver" RelativeSource="{RelativeSource Self}"/>
                                                        </MultiBinding>
                                                    </Border.BoxShadow>
                                                    <StackPanel Spacing="4">
                                                        <Border Classes="temp-bar" Background="{Binding CpuAverageTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}"/>
                                                        <TextBlock Text="AVERAGE" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <!-- Scales down instead of clipping in narrow cards (MinWidth 1100) -->
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding CpuAverageTemperature}" Classes="metric-value"
                                                                       Foreground="{Binding CpuAverageTempValue, Converter={x:Static conv:TemperatureToGradientConverter.Instance}}"/>
                                                        </Viewbox>
                                                        <TextBlock Text="Across cores" Classes="metric-caption" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Classes="card temp-card compact"
                                                        BorderBrush="{Binding CpuHotspotTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}">
                                                    <Border.BoxShadow>
                                                        <MultiBinding Converter="{x:Static conv:TemperatureToBoxShadowConverter.Instance}">
                                                            <Binding Path="CpuHotspotTempValue"/>
                                                            <Binding Path="IsPointerOver" RelativeSource="{RelativeSource Self}"/>
                                                        </MultiBinding>
                                                    </Border.BoxShadow>
                                                    <StackPanel Spacing="4">
                                                        <Border Classes="temp-bar" Background="{Binding CpuHotspotTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}"/>
                                                        <TextBlock Text="HOTSPOT" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <!-- Scales down instead of clipping in narrow cards (MinWidth 1100) -->
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding CpuHotspotTemperature}" Classes="metric-value"
                                                                       Foreground="{Binding CpuHotspotTempValue, Converter={x:Static conv:TemperatureToGradientConverter.Instance}}"/>
                                                        </Viewbox>
                                                        <TextBlock Text="Hottest" Classes="metric-caption" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Grid x:Name="CpuStatCards" Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                                <Border Grid.Row="0" Grid.Column="0" Classes="stat-tile">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="LOAD" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding CpuTotalLoad}" Classes="metric-value stat"/>
                                                        </Viewbox>
                                                        <Panel Classes="stat-footer"><ProgressBar Classes="thin" Value="{Binding CpuLoadValue}" VerticalAlignment="Center"/></Panel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="0" Grid.Column="1" Classes="stat-tile">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="AVG CLOCK" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding CpuAverageClock}" Classes="metric-value stat"/>
                                                        </Viewbox>
                                                        <TextBlock Text="Core frequency" Classes="metric-caption stat-footer" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="0" Classes="stat-tile">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="PKG POWER" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding CpuPackagePower}" Classes="metric-value stat"/>
                                                        </Viewbox>
                                                        <TextBlock Text="Package draw" Classes="metric-caption stat-footer" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="1" Classes="stat-tile">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="VOLTAGE" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding CpuCoreVoltage}" Classes="metric-value stat"/>
                                                        </Viewbox>
                                                        <TextBlock Text="Vcore" Classes="metric-caption stat-footer" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="GpuPanel" Grid.Column="1" Classes="hw-panel">
                                        <Grid RowSpacing="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" SharedSizeGroup="HwHeader"/>
                                                <RowDefinition Height="Auto" SharedSizeGroup="HwTemps"/>
                                                <RowDefinition Height="Auto" SharedSizeGroup="HwStats"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <Border Classes="hw-badge gpu" VerticalAlignment="Center">
                                                    <TextBlock Text="GPU"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <!-- Wraps to 2 lines so long model names stay readable at MinWidth; full name in the tooltip -->
                                                    <TextBlock x:Name="GpuTempNameText" Text="{Binding GpuName}" Classes="hw-name"
                                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GpuName}"/>
                                                    <TextBlock Text="Graphics · live sensors" Classes="metric-caption" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <Border Grid.Column="0" Classes="card temp-card compact"
                                                        BorderBrush="{Binding GpuCoreTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}">
                                                    <Border.BoxShadow>
                                                        <MultiBinding Converter="{x:Static conv:TemperatureToBoxShadowConverter.Instance}">
                                                            <Binding Path="GpuCoreTempValue"/>
                                                            <Binding Path="IsPointerOver" RelativeSource="{RelativeSource Self}"/>
                                                        </MultiBinding>
                                                    </Border.BoxShadow>
                                                    <StackPanel Spacing="4">
                                                        <Border Classes="temp-bar" Background="{Binding GpuCoreTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}"/>
                                                        <TextBlock Text="CORE" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <!-- Scales down instead of clipping in narrow cards (MinWidth 1100) -->
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding GpuCoreTemperature}" Classes="metric-value"
                                                                       Foreground="{Binding GpuCoreTempValue, Converter={x:Static conv:TemperatureToGradientConverter.Instance}}"/>
                                                        </Viewbox>
                                                        <TextBlock Text="GPU core" Classes="metric-caption" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Classes="card temp-card compact"
                                                        BorderBrush="{Binding GpuHotspotTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}">
                                                    <Border.BoxShadow>
                                                        <MultiBinding Converter="{x:Static conv:TemperatureToBoxShadowConverter.Instance}">
                                                            <Binding Path="GpuHotspotTempValue"/>
                                                            <Binding Path="IsPointerOver" RelativeSource="{RelativeSource Self}"/>
                                                        </MultiBinding>
                                                    </Border.BoxShadow>
                                                    <StackPanel Spacing="4">
                                                        <Border Classes="temp-bar" Background="{Binding GpuHotspotTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}"/>
                                                        <TextBlock Text="HOTSPOT" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <!-- Scales down instead of clipping in narrow cards (MinWidth 1100) -->
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding GpuHotspotTemperature}" Classes="metric-value"
                                                                       Foreground="{Binding GpuHotspotTempValue, Converter={x:Static conv:TemperatureToGradientConverter.Instance}}"/>
                                                        </Viewbox>
                                                        <TextBlock Text="Junction" Classes="metric-caption" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Grid x:Name="GpuStatCards" Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                                <Border Grid.Row="0" Grid.Column="0" Classes="stat-tile">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="LOAD" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding GpuLoad}" Classes="metric-value stat"/>
                                                        </Viewbox>
                                                        <Panel Classes="stat-footer"><ProgressBar Classes="thin" Value="{Binding GpuLoadValue}" VerticalAlignment="Center"/></Panel>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="0" Grid.Column="1" Classes="stat-tile">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="CLOCK" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding GpuClock}" Classes="metric-value stat"/>
                                                        </Viewbox>
                                                        <TextBlock Text="Core clock" Classes="metric-caption stat-footer" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="0" Classes="stat-tile">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="POWER" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock controls:AnimatedNumber.Text="{Binding GpuPower}" Classes="metric-value stat"/>
                                                        </Viewbox>
                                                        <TextBlock Text="Board power" Classes="metric-caption stat-footer" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="1" Classes="stat-tile">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="VRAM" Classes="section-title" TextTrimming="CharacterEllipsis"/>
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding GpuVram, TargetNullValue='—'}" Classes="metric-value stat"/>
                                                        </Viewbox>
                                                        <TextBlock Text="Used / total" Classes="metric-caption stat-footer" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Live thermal history: CPU + GPU temperature over the selected window (1 / 5 / 15 min) -->
                                <Border x:Name="ThermalHistoryPanel" Classes="card" Padding="20,16">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="ThermalHistoryTitleText" Text="{Binding HistoryTitle}" Classes="h2" FontSize="14"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="Live temperatures, colour-coded by heat" Classes="muted" FontSize="10"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <RadioButton Classes="segment" GroupName="HistoryWindow" Content="1 min"
                                                             IsChecked="{Binding IsHistoryWindow1Min, Mode=TwoWay}"
                                                             AutomationProperties.Name="Show the last 1 minute"/>
                                                <RadioButton Classes="segment" GroupName="HistoryWindow" Content="5 min"
                                                             IsChecked="{Binding IsHistoryWindow5Min, Mode=TwoWay}"
                                                             AutomationProperties.Name="Show the last 5 minutes"/>
                                                <RadioButton Classes="segment" GroupName="HistoryWindow" Content="15 min"
                                                             IsChecked="{Binding IsHistoryWindow15Min, Mode=TwoWay}"
                                                             AutomationProperties.Name="Show the last 15 minutes"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                                            <controls:ThermalHistoryChart x:Name="CpuHistoryChart" Grid.Column="0" Height="150" Title="CPU"
                                                                          History="{Binding History.CpuTemperature}"
                                                                          TimeWindow="{Binding HistoryWindow}"
                                                                          Revision="{Binding HistoryRevision}"
                                                                          AutomationProperties.Name="CPU temperature history"/>
                                            <controls:ThermalHistoryChart x:Name="GpuHistoryChart" Grid.Column="1" Height="150" Title="GPU"
                                                                          History="{Binding History.GpuTemperature}"
                                                                          TimeWindow="{Binding HistoryWindow}"
                                                                          Revision="{Binding HistoryRevision}"
                                                                          AutomationProperties.Name="GPU temperature history"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Cooling: CPU fan reading, manual duty slider and Apply / Auto on one full-width bar -->
                                <Border x:Name="CoolingCard" Classes="card-glow" Padding="20,16">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" MinWidth="170">
                                            <TextBlock Text="CPU COOLING" Classes="label-caps"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock controls:AnimatedNumber.Text="{Binding CpuFanSpeed}" FontSize="26" FontWeight="Black" Foreground="#E8F0FF"/>
                                                <TextBlock Text="{Binding CpuFanControl}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource FanziAccentHoverBrush}"
                                                           VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CpuFanName}" Classes="metric-caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CpuFanName}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="MANUAL DUTY" Classes="label-caps" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CpuFanDesiredLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding CpuFanDesiredPercent, Mode=TwoWay}" IsEnabled="{Binding CpuFanCanControl}"
                                                    AutomationProperties.Name="CPU fan manual duty"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Content="Apply" Classes="primary" Command="{Binding ApplyCpuFanCommand}" IsEnabled="{Binding CpuFanCanControl}" MinWidth="72"/>
                                            <Button Content="Auto" Command="{Binding AutoCpuFanCommand}" IsEnabled="{Binding CpuFanCanControl}" MinWidth="64"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ TAB: FAN CONTROL ═══════════════════════ -->
                    <TabItem Header="Fans">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Margin="0,12,12,12">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fan &amp; Pump Channels" FontSize="20" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <TextBlock Text="{Binding FanCountLabel}" Foreground="#4A6A8F" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="AI Auto-Fan:" FontSize="11" Foreground="#5A7FA8" VerticalAlignment="Center"/>
                                        <ToggleSwitch IsChecked="{Binding AiAutoFanEnabled}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 4.4: BIOS fan control — motherboard headers follow the BIOS Smart Fan settings -->
                                <Border x:Name="BiosFanControlCard" Classes="card" Padding="20,14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="Use BIOS fan settings" Classes="h2"/>
                                            <TextBlock x:Name="BiosFanControlStatusText" Text="{Binding BiosFanControlStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" x:Name="BiosFanControlToggle" IsChecked="{Binding UseBiosFanControl}" VerticalAlignment="Center"
                                                      ToolTip.Tip="Fans on motherboard headers follow the curves set in BIOS (Smart Fan). Turn off to control them from FANZi."
                                                      AutomationProperties.Name="Use BIOS fan settings for motherboard fan headers"/>
                                    </Grid>
                                </Border>

                                <!-- CPU fan curve editor: the active profile's FanCurve (what AI Auto-Fan follows) -->
                                <Border Classes="card" Padding="20,16,20,14">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="CPU fan curve" Classes="h2" VerticalAlignment="Center"/>
                                                    <Border Classes="pill info" VerticalAlignment="Center">
                                                        <TextBlock x:Name="FanCurvePresetText" Text="{Binding FanCurvePresetLabel}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{StaticResource FanziAccentSoftBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="FanCurveStatusText" Text="{Binding FanCurveStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <RadioButton Classes="segment" GroupName="FanCurvePreset" Content="Silent" IsChecked="{Binding IsFanCurveSilent}"
                                                             ToolTip.Tip="Whisper-quiet, fans low until 65 °C" AutomationProperties.Name="Silent fan curve preset"/>
                                                <RadioButton Classes="segment" GroupName="FanCurvePreset" Content="Balanced" IsChecked="{Binding IsFanCurveBalanced}"
                                                             ToolTip.Tip="Default — good cooling, low noise" AutomationProperties.Name="Balanced fan curve preset"/>
                                                <RadioButton Classes="segment" GroupName="FanCurvePreset" Content="Performance" IsChecked="{Binding IsFanCurvePerformance}"
                                                             ToolTip.Tip="Aggressive ramp from 45 °C — keeps temps low" AutomationProperties.Name="Performance fan curve preset"/>
                                                <RadioButton Classes="segment" GroupName="FanCurvePreset" Content="Full" IsChecked="{Binding IsFanCurveFull}"
                                                             ToolTip.Tip="100 % at every temperature" AutomationProperties.Name="Full speed fan curve preset"/>
                                                <Button Content="Reset" Command="{Binding ResetFanCurveCommand}" Padding="10,4" FontSize="11" Margin="4,0,0,0"
                                                        ToolTip.Tip="Back to the default (Balanced) curve" AutomationProperties.Name="Reset fan curve to default"/>
                                            </StackPanel>
                                        </Grid>
                                        <controls:FanCurveEditor x:Name="FanCurveEditor" Height="280"
                                                                 Points="{Binding FanCurvePoints, Mode=TwoWay}"
                                                                 CurrentTemperature="{Binding HottestTempValue}"
                                                                 AutomationProperties.Name="CPU fan curve editor"
                                                                 AutomationProperties.HelpText="Arrow keys move the selected point by 1 degree or 1 percent, Shift for 5. Page Up and Page Down select a point, Delete removes it, Insert adds one."/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock x:Name="FanCurveHelpText" Grid.Column="0" Classes="legend" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Text="Drag points · double-click to add · right-click to remove · arrow keys nudge (Shift ×5) · PgUp/PgDn select · Del removes"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                        ToolTip.Tip="Curve input: CPU hotspot → package → average core. AI Auto-Fan adds trend and acoustic smoothing on top.">
                                                <TextBlock Text="LIVE" Classes="section-title" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="FanCurveLiveText" Text="{Binding FanCurveDutyLabel}" FontSize="13" FontWeight="Black" VerticalAlignment="Center"
                                                           Foreground="{Binding HottestTempValue, Converter={x:Static conv:TemperatureToBrushConverter.Instance}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding FanChannels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FanChannelViewModel">
                                            <Border Margin="0,0,0,8" Classes="tile" CornerRadius="14" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderGradient}" Padding="16,12">
                                                <Grid ColumnDefinitions="2*,1.1*,1.8*" ColumnSpacing="14">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border CornerRadius="6" Background="#0F1E30" Padding="6,2">
                                                                <TextBlock Text="{Binding DeviceKindBadge}" FontSize="10" FontWeight="Black" Foreground="#3B82F6"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#E8F0FF" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource FanziTextMutedBrush}" FontSize="10" IsVisible="{Binding SourceLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="{Binding SpeedLabel}" FontSize="22" FontWeight="Black" Foreground="#2563EB"/>
                                                        <TextBlock Text="{Binding CapabilityMessage}" Foreground="{StaticResource FanziTextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="CURRENT" Classes="section-title"/>
                                                        <TextBlock Text="{Binding CurrentControlLabel}" FontSize="18" FontWeight="Bold" Foreground="#E8F0FF"/>
                                                        <TextBlock Text="TARGET" Classes="section-title" Margin="0,6,0,0"/>
                                                        <TextBlock Text="{Binding DesiredControlLabel}" FontSize="14" Foreground="#60A5FA"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                                        <StackPanel Spacing="0">
                                                            <Slider Minimum="0" Maximum="100" Value="{Binding DesiredPercent, Mode=TwoWay}" IsEnabled="{Binding CanControl}"/>
                                                            <!-- Range legend spans the slider track: 0 % left, 50 % centre, 100 % right -->
                                                            <Grid ColumnDefinitions="*,*,*">
                                                                <TextBlock Grid.Column="0" Text="0%" Classes="legend" HorizontalAlignment="Left"/>
                                                                <TextBlock Grid.Column="1" Text="50%" Classes="legend" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="100%" Classes="legend" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </StackPanel>
                                                        <Border IsVisible="{Binding ShowMinSpeedWarning}" CornerRadius="8" Background="#1A1000" BorderBrush="#78350F" BorderThickness="1" Padding="8,4">
                                                            <TextBlock Text="Below 20% — bearing wear risk" Foreground="#FDE68A" FontSize="10"/>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                            <Button Content="Apply" Classes="primary" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanControl}" MinWidth="65" Padding="8,5" FontSize="11"/>
                                                            <Button Content="Auto" Command="{Binding AutoCommand}" IsEnabled="{Binding CanControl}" MinWidth="65" Padding="8,5" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ TAB: SENSORS ═══════════════════════════ -->
                    <TabItem Header="Sensors">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <!-- Heatmap tile: colours come from TemperatureColorScale (°C or load %) and animate via the theme's BrushTransitions -->
                                <DataTemplate x:Key="HeatTileTemplate" x:DataType="vm:SensorTileViewModel">
                                    <Border Classes="heat-tile" Background="{Binding BackgroundBrush}" BorderBrush="{Binding BorderBrush}"
                                            AutomationProperties.Name="{Binding AutomationName}" ToolTip.Tip="{Binding AutomationName}">
                                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Grid.Row="0" Classes="heat-label" Text="{Binding Label}"/>
                                            <TextBlock Grid.Row="1" Classes="heat-value" controls:AnimatedNumber.Text="{Binding ValueText}" Foreground="{Binding ValueBrush}"/>
                                            <TextBlock Grid.Row="2" Classes="heat-detail" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"/>
                                            <ProgressBar Grid.Row="3" Classes="heat-bar" Value="{Binding FillPercent}" Foreground="{Binding AccentBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ScrollViewer.Resources>
                            <StackPanel Spacing="12" Margin="0,12,12,12">

                            <!-- Heatmap: per-core CPU tiles + CPU-wide sensors, GPU sensors -->
                            <Border Classes="card" Padding="18,16" x:Name="SensorHeatmapCard">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Thermal heatmap" Classes="h2"/>
                                            <TextBlock Text="Live per-core and GPU sensors — hotter tiles glow amber to red" Classes="metric-caption" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"
                                                    AutomationProperties.Name="Colour scale: 30 degrees blue to 95 degrees red">
                                            <Border Width="180" Height="8" CornerRadius="4" Background="{StaticResource TemperatureScaleGradient}"/>
                                            <Grid ColumnDefinitions="*,*,*" Width="180">
                                                <TextBlock Grid.Column="0" Text="30°" Classes="legend" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="1" Text="60°" Classes="legend" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="95°C" Classes="legend" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="18">
                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <TextBlock Text="CPU · PER CORE" Classes="label-caps" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" x:Name="CpuHeatmapCaptionText" Text="{Binding CpuHeatmapCaption}" Classes="legend" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Grid>
                                            <ItemsControl x:Name="CpuCoreHeatmap" ItemsSource="{Binding CpuCoreTiles}" ItemTemplate="{StaticResource HeatTileTemplate}"
                                                          IsVisible="{Binding HasCpuCoreTiles}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <TextBlock Text="CPU · PACKAGE" Classes="label-caps" Margin="0,4,0,0"/>
                                            <ItemsControl x:Name="CpuSummaryHeatmap" ItemsSource="{Binding CpuSummaryTiles}" ItemTemplate="{StaticResource HeatTileTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="GPU" Classes="label-caps"/>
                                            <ItemsControl x:Name="GpuHeatmap" ItemsSource="{Binding GpuTiles}" ItemTemplate="{StaticResource HeatTileTemplate}"
                                                          IsVisible="{Binding HasGpuTiles}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <Border Classes="tile empty" IsVisible="{Binding !HasGpuTiles}">
                                                <TextBlock Text="No GPU sensors exposed" Classes="muted" FontSize="11"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="card" Padding="16">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                        <StackPanel>
                                            <TextBlock Text="CPU Sensors" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                            <TextBlock Text="Temp · Load · Clock · Power" Foreground="{StaticResource FanziTextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="550">
                                            <ItemsControl ItemsSource="{Binding CpuReadings}" Margin="0,0,12,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="model:CpuReadingSnapshot">
                                                        <Border Margin="0,0,0,4" CornerRadius="8" Background="#060C14" Padding="10,5">
                                                            <Grid ColumnDefinitions="2*,*">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#6A8AAF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Classes="card" Padding="16">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                        <StackPanel>
                                            <TextBlock Text="GPU Sensors" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                            <TextBlock Text="Temp · Load · Clock · Power" Foreground="{StaticResource FanziTextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="550">
                                            <ItemsControl ItemsSource="{Binding GpuReadings}" Margin="0,0,12,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="model:GpuReadingSnapshot">
                                                        <Border Margin="0,0,0,4" CornerRadius="8" Background="#060C14" Padding="10,5">
                                                            <Grid ColumnDefinitions="2*,*">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#6A8AAF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#2563EB" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ TAB: RGB ════════════════════════════════ -->
                    <TabItem Header="RGB">
                        <views:RgbControlView DataContext="{Binding RgbControl}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- ══ TAB: TASK MANAGER ══════════════════════ -->
                    <TabItem Header="Tasks" IsVisible="{Binding ShowTaskManagerTab}">
                        <views:TaskManagerView DataContext="{Binding TaskManagerVm}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- ══ TAB: NETWORK MANAGER ═══════════════════ -->
                    <TabItem Header="Network" IsVisible="{Binding ShowNetworkManagerTab}">
                        <views:NetworkManagerView DataContext="{Binding NetworkManagerVm}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- ══ TAB: POWER MONITOR ═════════════════════ -->
                    <TabItem Header="Power" IsVisible="{Binding ShowPowerMonitorTab}">
                        <views:PowerMonitorView DataContext="{Binding PowerMonitorVm}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- ══ TAB: SYSTEM CLEANER ════════════════════ -->
                    <TabItem Header="Cleaner" IsVisible="{Binding ShowSystemCleanerTab}">
                        <views:SystemCleanerView DataContext="{Binding SystemCleanerVm}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- v4.1.0 TAB: TOOLS (disk optimiser, drive health, repair, network / quick fixes, power & gaming) -->
                    <TabItem Header="Tools" IsVisible="{Binding ShowToolsTab}">
                        <views:ToolsView DataContext="{Binding ToolsVm}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- 4.3 TAB: THERMAL BENCH (repeatable all-core cooling benchmark with a score) -->
                    <TabItem Header="Bench" IsVisible="{Binding ShowBenchTab}">
                        <views:ThermalBenchView DataContext="{Binding BenchVm}" Margin="0,12,0,0"/>
                    </TabItem>

                    <!-- ══ TAB: NOTIFICATIONS ═════════════════════ -->
                    <TabItem Header="Alerts">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14" Margin="0,12,12,12">

                                <Border CornerRadius="14" Background="#0A0D04" BorderBrush="#3A5A20" BorderThickness="1" Padding="18,14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Temperature Alert" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <Border IsVisible="{Binding HasCpuTempWarning}" CornerRadius="10" Background="#1C0D00" BorderBrush="#B45309" BorderThickness="1" Padding="12,8">
                                            <TextBlock Text="{Binding CpuTempWarningMessage}" Foreground="#FDE68A" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border IsVisible="{Binding !HasCpuTempWarning}" CornerRadius="10" Background="#041810" BorderBrush="#134E2A" BorderThickness="1" Padding="12,8">
                                            <TextBlock Text="CPU temperature within normal range" Foreground="#6EE7B7" FontSize="12"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="Warn above" Foreground="#6A8AAF" FontSize="12" VerticalAlignment="Center"/>
                                            <NumericUpDown Value="{Binding CpuWarningThresholdDegrees, Mode=TwoWay}" Minimum="30" Maximum="110" Increment="1" Width="110" Foreground="#E8F0FF" Background="#0A1220" FontSize="12" FormatString="0 '°C'"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="SMTP Email Alerts" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <TextBlock Text="Email alerts when thresholds are exceeded. 10-minute cooldown between alerts." Foreground="#4A6A8F" FontSize="11"/>
                                        <Grid ColumnDefinitions="120,*,70,120" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="SMTP Host" Foreground="#5A7FA8" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SmtpHost, Mode=TwoWay}" Watermark="smtp.gmail.com" Background="#060C14" Foreground="#A0C0E0" BorderBrush="#142238" CornerRadius="8" Padding="8,5" FontSize="12"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Port" Foreground="#5A7FA8" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding SmtpPort, Mode=TwoWay}" Minimum="1" Maximum="65535" FormatString="0" Background="#060C14" Foreground="#A0C0E0" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Username" Foreground="#5A7FA8" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SmtpUser, Mode=TwoWay}" Watermark="you@gmail.com" Background="#060C14" Foreground="#A0C0E0" BorderBrush="#142238" CornerRadius="8" Padding="8,5" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Pass" Foreground="#5A7FA8" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SmtpPassword, Mode=TwoWay}" PasswordChar="•" Background="#060C14" Foreground="#A0C0E0" BorderBrush="#142238" CornerRadius="8" Padding="8,5" FontSize="12"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Send To" Foreground="#5A7FA8" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding NotificationEmail, Mode=TwoWay}" Watermark="recipient@example.com" Background="#060C14" Foreground="#A0C0E0" BorderBrush="#142238" CornerRadius="8" Padding="8,5" FontSize="12"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button Content="Send Test" Classes="primary" Command="{Binding SendTestEmailCommand}" IsEnabled="{Binding SmtpConfigured}" MinWidth="100"/>
                                            <ProgressBar IsIndeterminate="True" Width="60" Height="3" Foreground="#2563EB" IsVisible="{Binding IsSendingEmail}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EmailStatus}" Foreground="#6A8AAF" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══ TAB: SETTINGS ══════════════════════════ -->
                    <TabItem Header="Settings">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14" Margin="0,12,12,12">

                                <!-- Alerts & Notifications -->
                                <Border Classes="card" x:Name="NotificationSettingsCard">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Classes="pill info" Padding="8,3">
                                                <TextBlock Text="🔔" FontSize="11"/>
                                            </Border>
                                            <TextBlock Text="Alerts &amp; Notifications" FontSize="16" FontWeight="Black" Foreground="#E8F0FF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Toast notifications" Foreground="#A0C0E0" FontSize="13"/>
                                                <TextBlock x:Name="ToastSettingHelpText" Classes="muted" FontSize="11" TextWrapping="Wrap"
                                                           Text="Pop-up alerts for CPU temperature over your threshold, detected anomalies, OpenRGB connected / failed and profile saved / loaded. Each alert shows at most once every 2 minutes. While FANZi is in the tray, alerts appear in the tray icon tooltip instead."/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" x:Name="ToastNotificationsToggle" IsChecked="{Binding ToastNotificationsEnabled}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                                          AutomationProperties.Name="Toast notifications"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Appearance & accessibility -->
                                <Border Classes="card" x:Name="AccessibilitySettingsCard">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Classes="pill info" Padding="8,3">
                                                <TextBlock Text="Aa" FontSize="11" FontWeight="Black" Foreground="{StaticResource FanziAccentSoftBrush}"/>
                                            </Border>
                                            <TextBlock Text="Appearance &amp; Accessibility" FontSize="16" FontWeight="Black" Foreground="#E8F0FF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Reduce motion" Foreground="#A0C0E0" FontSize="13"/>
                                                <TextBlock x:Name="ReduceMotionHelpText" Classes="muted" FontSize="11" TextWrapping="Wrap"
                                                           Text="Gauges jump straight to the new reading, numbers change without counting and the loading and pulse animations stand still. Press F1 any time for the keyboard shortcuts."/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" x:Name="ReduceMotionToggle" IsChecked="{Binding ReduceMotion}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                                          AutomationProperties.Name="Reduce motion"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Thermal frame" Foreground="#A0C0E0" FontSize="13"/>
                                                <TextBlock x:Name="ThermalFrameHelpText" Classes="muted" FontSize="11" TextWrapping="Wrap"
                                                           Text="A running line around the window shows the hotter of CPU and GPU: blue = cold, green = stable, amber / orange = warm, red = hot. It runs faster as it gets hotter and stands still with Reduce motion."/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" x:Name="ThermalFrameToggle" IsChecked="{Binding ThermalFrameEnabled}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                                          AutomationProperties.Name="Thermal frame"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Startup & Tray -->
                                <Border Classes="card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Startup &amp; System Tray" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start with Windows" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding StartWithWindows}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Start minimized to tray" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding StartMinimized}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Minimize to system tray" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding MinimizeToTray}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Close to tray (keep running)" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding CloseToTray}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Overlay transparent background" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="4" Grid.Column="1" IsChecked="{Binding OverlayTransparent}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Overlay opacity" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <Slider Grid.Row="5" Grid.Column="1" Minimum="0.1" Maximum="1.0" Value="{Binding OverlayOpacity, Mode=TwoWay}" Width="140" HorizontalAlignment="Right" Foreground="#2563EB"/>
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Overlay always on top" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="6" Grid.Column="1" IsChecked="{Binding OverlayTopmost}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding StartupStatus}" Foreground="#22C55E" FontSize="11" TextWrapping="Wrap"
                                                   IsVisible="{Binding StartupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <Border CornerRadius="8" Background="#060C14" Padding="12,8">
                                            <TextBlock Text="When minimized, FANZI reduces polling to save CPU. Right-click the tray icon to restore or exit." Foreground="{StaticResource FanziTextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- v4 Overlay Studio: customise every row of the mini overlay -->
                                <Border Classes="card" x:Name="OverlayStudioCard">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Classes="pill info" Padding="8,3">
                                                <TextBlock Text="▣" FontSize="11" FontWeight="Black" Foreground="{StaticResource FanziAccentSoftBrush}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Overlay Studio" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                                           Text="Pick what the floating mini overlay shows, its size and accent. Changes apply live and are saved."/>
                                            </StackPanel>
                                            <Button Grid.Column="2" x:Name="OverlayStudioToggleButton" Classes="primary" Command="{Binding ToggleMiniOverlayCommand}"
                                                    Padding="14,8" FontWeight="Bold" VerticalAlignment="Center"
                                                    Content="{Binding OverlayToggleText}"/>
                                        </Grid>
                                        <WrapPanel x:Name="OverlayStudioToggles" Orientation="Horizontal">
                                            <CheckBox Content="CPU gauge" IsChecked="{Binding OverlayShowCpu}" Margin="0,0,16,6"/>
                                            <CheckBox Content="GPU gauge" IsChecked="{Binding OverlayShowGpu}" Margin="0,0,16,6"/>
                                            <CheckBox Content="CPU history" IsChecked="{Binding OverlayShowCpuHistory}" Margin="0,0,16,6"/>
                                            <CheckBox Content="Fan / pump" IsChecked="{Binding OverlayShowFan}" Margin="0,0,16,6"/>
                                            <CheckBox Content="CPU load" IsChecked="{Binding OverlayShowCpuLoad}" Margin="0,0,16,6"/>
                                            <CheckBox Content="GPU load" IsChecked="{Binding OverlayShowGpuLoad}" Margin="0,0,16,6"/>
                                            <CheckBox Content="RAM" IsChecked="{Binding OverlayShowRam}" Margin="0,0,16,6"/>
                                            <CheckBox Content="Network ↓ ↑" IsChecked="{Binding OverlayShowNetwork}" Margin="0,0,16,6"/>
                                            <CheckBox Content="Health" IsChecked="{Binding OverlayShowHealth}" Margin="0,0,16,6"/>
                                            <CheckBox Content="Clock" IsChecked="{Binding OverlayShowClock}" Margin="0,0,16,6"/>
                                            <CheckBox Content="Compact (gauges only)" IsChecked="{Binding OverlayCompact}" Margin="0,0,16,6"/>
                                        </WrapPanel>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,*" ColumnSpacing="12">
                                            <TextBlock Text="Size" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0.8" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                    Value="{Binding OverlayScale, Mode=TwoWay}" Foreground="#2563EB" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding OverlayScale, StringFormat='{}{0:P0}'}" Foreground="#60A5FA" FontWeight="Bold"
                                                       FontSize="12" VerticalAlignment="Center" MinWidth="44"/>
                                            <TextBlock Grid.Column="3" Text="Accent" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <ComboBox Grid.Column="4" ItemsSource="{Binding OverlayAccentNames}" SelectedItem="{Binding OverlayAccent, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" FontSize="12"/>
                                        </Grid>
                                        <WrapPanel>
                                            <TextBlock Text="Snap:" Foreground="#5A7899" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                            <Button Content="↖ Top left" Classes="ghost" Command="{Binding SnapOverlayCommand}" CommandParameter="TopLeft" Padding="10,4" FontSize="11" Margin="0,0,6,6"/>
                                            <Button Content="↗ Top right" Classes="ghost" Command="{Binding SnapOverlayCommand}" CommandParameter="TopRight" Padding="10,4" FontSize="11" Margin="0,0,6,6"/>
                                            <Button Content="↙ Bottom left" Classes="ghost" Command="{Binding SnapOverlayCommand}" CommandParameter="BottomLeft" Padding="10,4" FontSize="11" Margin="0,0,6,6"/>
                                            <Button Content="↘ Bottom right" Classes="ghost" Command="{Binding SnapOverlayCommand}" CommandParameter="BottomRight" Padding="10,4" FontSize="11" Margin="0,0,6,6"/>
                                            <Button Content="Reset layout" Classes="ghost" Command="{Binding ResetOverlayLayoutCommand}" Padding="10,4" FontSize="11" Margin="12,0,6,6"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="OverlayStatusText" Text="{Binding OverlayStatus}" Foreground="#22C55E" FontSize="11" TextWrapping="Wrap"
                                                   IsVisible="{Binding OverlayStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Shortcuts & Pinning -->
                                <Border Classes="card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Shortcuts &amp; Pinning" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <TextBlock Text="Pin FANZI where you launch things from. The Taskbar pin may need a right-click confirmation on Windows 11."
                                                   Foreground="#5A7899" FontSize="11" TextWrapping="Wrap"/>
                                        <WrapPanel>
                                            <Button Content="📌 Pin to Taskbar"   Command="{Binding PinToTaskbarCommand}"   Padding="14,8" Margin="0,0,8,8" Background="#1E3A60" Foreground="#FFF" CornerRadius="8" FontWeight="Bold"/>
                                            <Button Content="🏠 Pin to Start"     Command="{Binding PinToStartCommand}"      Padding="14,8" Margin="0,0,8,8" Background="#1E3A60" Foreground="#FFF" CornerRadius="8" FontWeight="Bold"/>
                                            <Button Content="🖥 Desktop Shortcut" Command="{Binding CreateDesktopShortcutCommand}" Padding="14,8" Margin="0,0,8,8" Background="#1E3A60" Foreground="#FFF" CornerRadius="8" FontWeight="Bold"/>
                                            <Button Content="📊 Toggle Mini Overlay" Command="{Binding ToggleMiniOverlayCommand}" Padding="14,8" Margin="0,0,8,8" Background="#1E3A60" Foreground="#FFF" CornerRadius="8" FontWeight="Bold"/>
                                            <Button Content="📋 Export Hardware Report" Command="{Binding ExportHardwareReportCommand}" Padding="14,8" Margin="0,0,8,8" Background="#1E3A60" Foreground="#FFF" CornerRadius="8" FontWeight="Bold"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding PinningStatus}" Foreground="#22C55E" FontSize="11"/>
                                        <TextBlock Text="{Binding HardwareReportStatus}" Foreground="#FB923C" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- Profile Manager (disk) -->
                                <Border Classes="card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Profile Library" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#5A7899" FontSize="11">
                                            <Run Text="Saved at "/>
                                            <Run Text="{Binding ProfilesDirectoryPath, Mode=OneWay}" FontFamily="Consolas,monospace" Foreground="#7090B0"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="💾 Save Current Profile" Command="{Binding SaveCurrentProfileCommand}" Classes="primary" Padding="14,6" FontWeight="Bold"/>
                                            <Button Content="🔄 Refresh List" Command="{Binding RefreshProfileListCommand}" Padding="14,6"/>
                                            <Button Content="📁 Open Folder" Command="{Binding OpenProfilesFolderCommand}" Padding="14,6"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProfileSaveStatus}" Foreground="#22C55E" FontSize="11"/>
                                        <Border Background="#061018" CornerRadius="10" MaxHeight="240">
                                            <DataGrid ItemsSource="{Binding DiskProfiles}" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                                      Background="Transparent" Foreground="#C4D8F4" RowBackground="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="Saved" Binding="{Binding LastModifiedDisplay}" Width="140"/>
                                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80"/>
                                                    <DataGridTemplateColumn Header="Actions" Width="180">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="Load" Padding="10,3" FontSize="11"
                                                                            Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).LoadProfileFromDiskCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Content="Delete" Padding="10,3" FontSize="11" Classes="danger"
                                                                            Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).DeleteProfileFromDiskCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Modular Section Toggles -->
                                <Border Classes="card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Modular Sections" FontSize="16" FontWeight="Black" Foreground="#E8F0FF"/>
                                        <TextBlock Text="Show/hide tabs you don't use. Disabled sections stop their background polling." Foreground="#5A7899" FontSize="11" TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Task Manager tab" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding ShowTaskManagerTab}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Network Manager tab" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding ShowNetworkManagerTab}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Power Monitor &amp; Drives tab" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding ShowPowerMonitorTab}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" Margin="0,6,0,0">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="System Cleaner tab (cache + RAM cleaner)" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding ShowSystemCleanerTab}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tools tab (disk optimiser, drive health, repair, power &amp; gaming)" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding ShowToolsTab}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Bench tab (repeatable all-core cooling benchmark with a score)" Foreground="#A0C0E0" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding ShowBenchTab}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- AI Settings -->
                                <Border Classes="card-accent">
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border CornerRadius="8" Background="#0A1A10" Padding="8,4">
                                                <TextBlock Text="AI" FontSize="11" FontWeight="Black" Foreground="#34D399"/>
                                            </Border>
                                            <TextBlock Text="Thermal Intelligence" FontSize="16" FontWeight="Black" Foreground="#E8F0FF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                                <TextBlock Text="AI Auto-Fan Control" Foreground="#A0C0E0" FontSize="13"/>
                                                <TextBlock Text="AI continuously adjusts fan speed using predictive thermal modeling" Foreground="{StaticResource FanziTextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding AiAutoFanEnabled}" HorizontalAlignment="Right"/>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Anomaly Detection" Foreground="#A0C0E0" FontSize="13"/>
                                                <TextBlock Text="Detect thermal spikes, fan stalls, and unusual behavior patterns" Foreground="{StaticResource FanziTextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding AiAnomalyDetection}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border CornerRadius="8" Background="#040A10" Padding="12,8">
                                            <TextBlock TextWrapping="Wrap" Foreground="#4A6A8F" FontSize="11"
                                                       Text="The AI engine uses PD-control thermal prediction with exponential smoothing. It learns from your system's thermal characteristics over time and pre-emptively adjusts fan speed before temperatures spike."/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- About -->
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <Panel Width="48" Height="48" VerticalAlignment="Center">
                                                <Ellipse Width="72" Height="72" Margin="-12" Fill="{StaticResource LogoGlow}" Opacity="0.75"
                                                         IsHitTestVisible="False" Effect="blur(10)"/>
                                                <Image Source="/Assets/ionity-logo.png" Width="48" Opacity="0.95"/>
                                            </Panel>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Static services:AppVersion.ProductTitle}" FontSize="18" FontWeight="Black" Foreground="{StaticResource AccentGradient}"/>
                                                <TextBlock Text="AI Thermal Intelligence &amp; RGB Lighting" FontSize="12" Foreground="#6A8AAF"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="© 2018-2026 Antwerp Designs. ALL Rights Reserved." Foreground="{StaticResource FanziTextMutedBrush}" FontSize="11"/>
                                        <TextBlock Text="Johan Wilhelm van Antwerp · AI@IONITY.TODAY" Foreground="{StaticResource FanziTextMutedBrush}" FontSize="11"/>
                                        <TextBlock Text="POL986 AED License 990|900 · FREE TO USE" Foreground="{StaticResource FanziTextMutedBrush}" FontSize="11"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FanziTextMutedBrush}" FontSize="10"
                                                   Text="Powered by LibreHardwareMonitor, OpenRGB, Avalonia UI, and custom AI thermal intelligence."/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>

                </Grid> <!-- End left content -->

                <!-- ═══ RIGHT: AEDi Sidebar ═══ -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="10">

                    <!-- AEDi Header -->
                    <Border Grid.Row="0" Classes="card-accent" CornerRadius="14" Padding="14,10">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" CornerRadius="8" Background="{StaticResource AccentGradient}" Padding="6,3">
                                    <TextBlock Text="AEDi" FontSize="12" FontWeight="Black" Foreground="#FFF"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="by Ionity" FontSize="10" Foreground="#4A6A8F" VerticalAlignment="Center" Margin="6,0"/>
                                <TextBlock Grid.Column="2" Text="{x:Static services:AppVersion.ShortLabel}" FontSize="9" Foreground="#3A5070" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Search &amp; Ping AI" FontSize="9" Foreground="#5A7899" LetterSpacing="1"/>
                        </StackPanel>
                    </Border>

                    <!-- Search Area -->
                    <Border Grid.Row="1" Classes="card" CornerRadius="14" Padding="12,10">
                        <StackPanel Spacing="8">
                            <!-- Search Input -->
                            <TextBox Text="{Binding AediQuery, Mode=TwoWay}" Watermark="Search or type command..."
                                     Background="#0A1422" Foreground="#E8F0FF" BorderBrush="#1E3A60" CornerRadius="8"
                                     Padding="10,6" FontSize="12">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Return" Command="{Binding AediSearchCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Content="🔍 Search" Command="{Binding AediSearchCommand}" Classes="primary"
                                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="11"/>

                            <!-- Welcome / Status -->
                            <TextBlock Text="{Binding AediWelcome}" FontSize="10" Foreground="#4A6A8F" TextWrapping="Wrap"/>

                            <!-- Results -->
                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding AediResults}" FontSize="11" Foreground="#A0C0E0"
                                           TextWrapping="Wrap" IsVisible="{Binding HasAediResults}" LineSpacing="2"/>
                            </ScrollViewer>

                            <!-- Quick Commands -->
                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <TextBlock Text="QUICK PING" FontSize="9" FontWeight="Bold" Foreground="#4E6E95" LetterSpacing="1"/>
                                <WrapPanel>
                                    <Button Content="Dashboard" Command="{Binding AediNavigateCommand}" CommandParameter="0" Margin="0,0,4,4" Padding="8,3" FontSize="9" Background="#141E30"/>
                                    <Button Content="Fans" Command="{Binding AediNavigateCommand}" CommandParameter="1" Margin="0,0,4,4" Padding="8,3" FontSize="9" Background="#141E30"/>
                                    <Button Content="Sensors" Command="{Binding AediNavigateCommand}" CommandParameter="2" Margin="0,0,4,4" Padding="8,3" FontSize="9" Background="#141E30"/>
                                    <Button Content="RGB" Command="{Binding AediNavigateCommand}" CommandParameter="3" Margin="0,0,4,4" Padding="8,3" FontSize="9" Background="#141E30"/>
                                    <Button Content="Tasks" Command="{Binding AediNavigateCommand}" CommandParameter="4" Margin="0,0,4,4" Padding="8,3" FontSize="9" Background="#141E30"/>
                                    <Button Content="Network" Command="{Binding AediNavigateCommand}" CommandParameter="5" Margin="0,0,4,4" Padding="8,3" FontSize="9" Background="#141E30"/>
                                    <Button Content="Power" Command="{Binding AediNavigateCommand}" CommandParameter="6" Margin="0,0,4,4" Padding="8,3" FontSize="9" Background="#141E30"/>
                                    <Button Content="Clean" Command="{Binding AediNavigateCommand}" CommandParameter="7" Margin="0,0,4,4" Padding="8,3" FontSize="9" Background="#141E30"/>
                                    <Button Content="Tools" Command="{Binding AediNavigateCommand}" CommandParameter="8" Margin="0,0,4,4" Padding="8,3" FontSize="9" Background="#141E30"/>
                                    <Button Content="Alerts" Command="{Binding AediNavigateCommand}" CommandParameter="9" Margin="0,0,4,4" Padding="8,3" FontSize="9" Background="#141E30"/>
                                    <Button Content="Settings" Command="{Binding AediNavigateCommand}" CommandParameter="10" Margin="0,0,4,4" Padding="8,3" FontSize="9" Background="#141E30"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Google Profile -->
                    <Border Grid.Row="2" Classes="card" CornerRadius="14" Padding="12,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="GOOGLE PROFILE" FontSize="9" FontWeight="Bold" Foreground="#4E6E95" LetterSpacing="1"/>

                            <!-- Logged out state -->
                            <StackPanel IsVisible="{Binding !IsLoggedInGoogle}" Spacing="4">
                                <Button Content="🔑 Sign in with Google" Command="{Binding GoogleLoginCommand}"
                                        HorizontalAlignment="Stretch" Padding="10,6" FontSize="10"
                                        Background="#1A3A60" Foreground="#E8F0FF"/>
                                <TextBlock Text="Save profiles to Google Drive" FontSize="9" Foreground="#4A6A8F"/>
                            </StackPanel>

                            <!-- Logged in state -->
                            <StackPanel IsVisible="{Binding IsLoggedInGoogle}" Spacing="4">
                                <Border CornerRadius="8" Background="#0A1A10" Padding="8,4" BorderBrush="#166534" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GoogleUserName}" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                        <TextBlock Text="{Binding GoogleUserEmail}" FontSize="9" Foreground="#5A7899"/>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                    <Button Grid.Column="0" Content="↑ Sync Up" Command="{Binding GoogleSyncUpCommand}"
                                            Padding="6,4" FontSize="9" Background="#141E30" Foreground="#60A5FA"/>
                                    <Button Grid.Column="1" Content="↓ Sync Down" Command="{Binding GoogleSyncDownCommand}"
                                            Padding="6,4" FontSize="9" Background="#141E30" Foreground="#60A5FA"/>
                                </Grid>
                                <Button Content="Sign Out" Command="{Binding GoogleLogoutCommand}"
                                        Padding="6,3" FontSize="9" Background="Transparent" Foreground="#6A8AAF"
                                        HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding GoogleSyncStatus}" FontSize="9" Foreground="#5A7899" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Text="{Binding GoogleStatus}" FontSize="9" Foreground="#3A5070"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- ── HELP PANEL ──────────────────────────────────── -->
            <Border x:Name="HelpPanel" IsVisible="{Binding ShowHelp}" ZIndex="50" Margin="20,80,20,0" VerticalAlignment="Top"
                    Classes="panel" BorderBrush="{StaticResource GlowBorderGradient}" Padding="20"
                    BoxShadow="0 8 32 4 #CC000000, 0 0 24 0 #262563EB, inset 0 1 0 0 #1AFFFFFF">
                <Grid ColumnDefinitions="3*,2*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="28" RowSpacing="12">
                    <TextBlock Grid.ColumnSpan="2" Text="FANZI Quick Guide" Classes="h1" FontSize="18"/>
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="10">
                        <TextBlock TextWrapping="Wrap" Foreground="#6A8AAF" FontSize="12" Text="FANZI requires administrator privileges to access hardware sensors via LibreHardwareMonitor kernel drivers."/>
                        <TextBlock TextWrapping="Wrap" Foreground="#6A8AAF" FontSize="12" Text="Fan channels are auto-detected. Motherboard headers follow your BIOS fan settings by default (Fans → Use BIOS fan settings); switch it off to use sliders, Apply and Auto."/>
                        <TextBlock TextWrapping="Wrap" Foreground="#6A8AAF" FontSize="12" Text="RGB control works out of the box — FANZI launches OpenRGB automatically in the background (SDK port 6742) and connects on its own. Just open the RGB tab."/>
                        <TextBlock TextWrapping="Wrap" Foreground="#6A8AAF" FontSize="12" Text="AI engine learns your system's thermal characteristics and predictively adjusts fans. Enable in Settings."/>
                    </StackPanel>
                    <!-- Keyboard shortcuts (KeyboardShortcuts.HelpEntries — the same table the window handles) -->
                    <Border Grid.Row="1" Grid.Column="1" Classes="tile section" Padding="14,12" VerticalAlignment="Top">
                        <StackPanel Spacing="8">
                            <TextBlock Text="KEYBOARD SHORTCUTS" Classes="label-caps"/>
                            <ItemsControl x:Name="HelpShortcutsList" ItemsSource="{Binding ShortcutHelpEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:ShortcutHelp">
                                        <Grid ColumnDefinitions="104,*" ColumnSpacing="10" Margin="0,0,0,6">
                                            <Border Classes="kbd">
                                                <TextBlock Text="{Binding Keys}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#A0C0E0" FontSize="12"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Close" Command="{Binding ToggleHelpCommand}" HorizontalAlignment="Right" MinWidth="80"
                            ToolTip.Tip="Close the guide (F1)"/>
                </Grid>
            </Border>
        </Panel>

        <!-- ═══════════════ THERMAL FRAME (4.1) ═══════════════ -->
        <!-- Running temperature line around the whole window: blue cold · green stable · red hot.
             Not hit-testable; corner radius follows the window state (square when maximised, see code-behind). -->
        <controls:ThermalFrame x:Name="ThermalFrame" ZIndex="300"
                               IsVisible="{Binding ThermalFrameEnabled}"
                               Temperature="{Binding FrameTemperatureValue}"
                               IsAnimated="{Binding !ReduceMotion}"
                               FrameRadius="8" StrokeThickness="3"/>
    </Panel>

</Window>
