<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fanzi.FanControl.Controls.ThermalGauge"
             ClipToBounds="False"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
    <UserControl.Styles>
        <!-- Living gradient: the aura ring behind the dial slowly turns and breathes (class "living" is
             set from code and dropped under Reduce motion, so the animations stop). -->
        <Style Selector="Ellipse.gauge-aura.living">
            <Style.Animations>
                <Animation Duration="0:0:16" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
                <Animation Duration="0:0:3.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.95"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <!-- Sizes, strokes, brushes and texts are driven from code-behind (ThermalGauge.axaml.cs). -->
    <Panel x:Name="PART_Root" Width="160" Height="160">

        <!-- Living gradient aura: conic ring (value heat colour + brand violet / blue), masked to a soft band -->
        <Ellipse x:Name="PART_Aura" Classes="gauge-aura" Margin="-10" IsHitTestVisible="False"
                 Opacity="0.75" RenderTransformOrigin="50%,50%">
            <Ellipse.RenderTransform>
                <RotateTransform Angle="0"/>
            </Ellipse.RenderTransform>
            <Ellipse.OpacityMask>
                <RadialGradientBrush>
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="0.66"/>
                    <GradientStop Color="#FF000000" Offset="0.80"/>
                    <GradientStop Color="#B0000000" Offset="0.90"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.OpacityMask>
        </Ellipse>

        <!-- Radial glow behind the dial, tinted by TemperatureColorScale -->
        <Ellipse x:Name="PART_Glow" Margin="-18" IsHitTestVisible="False">
            <Ellipse.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6"/>
                </Transitions>
            </Ellipse.Transitions>
        </Ellipse>

        <!-- Track: 270° from bottom-left, clockwise over the top, to bottom-right -->
        <Arc x:Name="PART_Track"
             StartAngle="135" SweepAngle="270"
             Stroke="#142238" StrokeThickness="12"
             StrokeLineCap="Round"/>

        <!-- Value arc -->
        <Arc x:Name="PART_Value"
             StartAngle="135" SweepAngle="0"
             StrokeThickness="12"
             StrokeLineCap="Round">
            <Arc.Transitions>
                <Transitions>
                    <!-- Duration is re-tuned per reading from the live cadence (ThermalGauge.axaml.cs, LiveCadence) -->
                    <DoubleTransition Property="SweepAngle" Duration="0:0:0.6" Easing="LinearEasing"/>
                </Transitions>
            </Arc.Transitions>
        </Arc>

        <!-- Centre readout -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="PART_ValueText" Text="--" FontWeight="Black" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="PART_UnitText" FontWeight="Bold" Foreground="#6A8AAF"
                           VerticalAlignment="Top" Margin="2,6,0,0"/>
            </StackPanel>
            <TextBlock x:Name="PART_LabelText" FontWeight="Bold" Foreground="#5A7FA8"
                       LetterSpacing="2" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Panel>
</UserControl>
