<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\ionity-logo-rounded.ico</ApplicationIcon>
    <Product>FANZi IO-nity</Product>
    <Company>Ionity Global (Pty) Ltd</Company>
    <Authors>Johan Wilhelm van Antwerp — Ionity Global</Authors>
    <Copyright>© 2018-2026 Antwerp Designs | Ionity Global (Pty) Ltd. MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>FANZi IO-nity — AI Thermal Intelligence, Smart Fan Control, RGB Lighting &amp; System Health Monitoring. Powered by AEDi (Antwerp Ecosystems Designs Ionity) AI Engine.</Description>
    <Version>4.6.0</Version>
  </PropertyGroup>

  <!-- 4.6 "Sign in with Google": the Desktop OAuth client JSON (Google Cloud console → Download JSON), saved as
       google_oauth.json next to FANZI.slnx, is compiled into the app. The file is git-ignored; CI writes it from the
       GOOGLE_OAUTH_JSON repository secret. Without it the build still works and sign-in asks for the file. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\google_oauth.json')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\google_oauth.json" LogicalName="Fanzi.FanControl.google_oauth.json" Link="google_oauth.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fanzi.FanControl.Tests" />
    <InternalsVisibleTo Include="Fanzi.FanControl.RenderTests" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Models\" />
    <Folder Include="AI\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.23">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="OpenRGB.NET" Version="3.1.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
</Project>
