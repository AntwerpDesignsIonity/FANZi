<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="520"
        x:Class="Fanzi.Installer.InstallerWindow"
        Title="FANZI Installer"
        Width="620" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#050A12"
        Icon="/Assets/ionity-logo.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        ExtendClientAreaChromeHints="NoChrome">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3B82F6"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#141E30"/>
            <Setter Property="Foreground" Value="#A0C0E0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E3050"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#A0C0E0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Titlebar -->
        <Border Height="32" VerticalAlignment="Top" ZIndex="100" Background="#050A12">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/ionity-logo.png" Width="16" Height="16" Opacity="0.8"/>
                <TextBlock Text="FANZI Installer" FontSize="11" FontWeight="Bold" Foreground="#4A6A8F" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,32,0,0" RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Border Grid.Row="0" Padding="32,24,32,20" Background="#080E18">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Image Source="/Assets/ionity-logo.png" Width="56" Opacity="0.95"/>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="FANZI" FontSize="32" FontWeight="Black" Foreground="#2563EB"/>
                            <TextBlock Text="AI-Powered Fan Control &amp; RGB Lighting" FontSize="13" Foreground="#6A8AAF"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Version 2.0.0 — © 2018-2026 Antwerp Designs" FontSize="11" Foreground="#2A4060" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Border Grid.Row="1" Padding="32,20">
                <Panel>
                    <!-- Step 1: Options (visible before install) -->
                    <StackPanel x:Name="OptionsPanel" Spacing="16">
                        <TextBlock Text="Installation Options" FontSize="16" FontWeight="Bold" Foreground="#E8F0FF"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Install Location:" Foreground="#6A8AAF" FontSize="12"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox x:Name="InstallPathBox" Background="#0A1220" Foreground="#E8F0FF" BorderBrush="#1A2845" CornerRadius="8" Padding="10,8" FontSize="12"/>
                                <Button Grid.Column="1" x:Name="BrowseButton" Content="Browse" Classes="secondary"/>
                            </Grid>
                        </StackPanel>

                        <Border CornerRadius="12" Background="#0A1220" BorderBrush="#1A2845" BorderThickness="1" Padding="16,14">
                            <StackPanel Spacing="10">
                                <CheckBox x:Name="DesktopShortcutCheck" Content="Create Desktop shortcut" IsChecked="True"/>
                                <CheckBox x:Name="StartMenuCheck" Content="Create Start Menu entry" IsChecked="True"/>
                                <CheckBox x:Name="StartupCheck" Content="Start FANZI with Windows" IsChecked="False"/>
                                <CheckBox x:Name="LaunchAfterCheck" Content="Launch FANZI after installation" IsChecked="True"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8" Background="#060C14" Padding="12,8">
                            <TextBlock TextWrapping="Wrap" Foreground="#3A5A80" FontSize="11"
                                       Text="FANZI requires administrator privileges for hardware sensor access. The installer will place files in Program Files and optionally register startup entries."/>
                        </Border>
                    </StackPanel>

                    <!-- Step 2: Progress (visible during install) -->
                    <StackPanel x:Name="ProgressPanel" IsVisible="False" Spacing="14" VerticalAlignment="Center">
                        <TextBlock x:Name="ProgressTitle" Text="Installing FANZI..." FontSize="18" FontWeight="Bold" Foreground="#E8F0FF" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" Foreground="#2563EB" CornerRadius="3" Margin="0,8"/>
                        <TextBlock x:Name="ProgressStatus" Text="Preparing..." FontSize="12" Foreground="#6A8AAF" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Step 3: Complete (visible after install) -->
                    <StackPanel x:Name="CompletePanel" IsVisible="False" Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border CornerRadius="50" Width="80" Height="80" Background="#0A1A10" HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontSize="40" FontWeight="Black" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Installation Complete!" FontSize="22" FontWeight="Black" Foreground="#E8F0FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="FANZI has been installed successfully." FontSize="13" Foreground="#6A8AAF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="InstallLocationLabel" FontSize="11" Foreground="#3A5A80" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Panel>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="32,14" Background="#080E18" BorderBrush="#1A2845" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="© 2018-2026 Antwerp Designs · AI@IONITY.TODAY" FontSize="10" Foreground="#2A4060" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" Classes="secondary"/>
                    <Button Grid.Column="2" x:Name="InstallButton" Content="Install" Classes="primary" MinWidth="120"/>
                </Grid>
            </Border>
        </Grid>
    </Panel>
</Window>
